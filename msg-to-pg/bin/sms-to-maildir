#!/usr/bin/env perl
# sms-to-maildir -- convert SMS Backup & Restore XML to a plain-text Maildir
#
# Filters to messages involving the wanted area codes (default: 734, 603).
# Phone numbers are normalized to bare 10 digits (NPA-NXX-XXXX, no punctuation)
# and become user@sms.org addresses.
# All output is plain RFC 2822 -- no MIME, no inline base64.
# Binary attachments are decoded to smsdir/inc/<md5>.<ext> (content-addressed;
# duplicates are hard-linked) and referenced via X-Attachment: headers.
#
# Configuration -- edit %opt to change behaviour:

use common::sense;
use Nobody::Util;
use XML::LibXML::Simple qw(XMLin);
use POSIX qw(strftime);
use MIME::Base64 qw(decode_base64);
use Digest::MD5 qw(md5_hex);
use JSON::XS qw( encode_json decode_json );

my %filt; 
for( qw( 
7343551065 7346461004 7346656622 6038651077
7343551065 6038031699 7342726715 7342726715 7343551065 7346461004
7342726715 7346461004
)) {
$filt{$_}++;
};
sub fr_addr;
sub to_addr;
sub date;
our(@parts,@part,$part,$parts,%parts);
{
  package MultiHash;
  use Nobody::Util;
  sub TIEHASH {
    my($class)=class(shift);
    my(%self);
    bless(\%self,$class);
  };
  sub CLEAR {
    my($hash)=shift;
    %{$hash}=();
  };
  use Tie::Hash;
  sub FIRSTKEY {
    local($_)=scalar(keys(%{$_[0]}));
    each %{$_[0]};
  };
  sub NEXTKEY {
    each %{$_[0]};
  };
  sub STORE {
    local(@_)=@_;
    my($hash,$key,$val)=@_;
    if(defined($hash->{$key})){
      push(@{$hash->{$key}},@_);
    } else {
      $hash->{$key}=[$val];
    };
  };
  sub FETCH {
    local(@_)=@_;
    my($hash,$key)=@_;
    $hash->{$key};
  };
};
sub body {
  return $_->{mms_body} if defined $_->{mms_body};
  return $_->{body} if defined $_->{body};
  $DB::single=1;
  for(@{$_->{attach}}){
      eex($_);
  };
  die "failed to find text";
};
sub parts {
  my($msg)=shift;
  return {} unless defined $msg->{parts};
  local(@_)=@{delete $msg->{parts}};
  for(keys @_){
    if(defined($_[$_]->{part})) {
      splice(@_,$_,1,@{$_[$_]->{part}});
    };
  };
  return @_;
};
{
  package Msg;
  use Nobody::Util;
  sub new {
    local(@_)=@_;
    my($class)=class(shift);
    our(%data);
    local(*data)=shift;
    my($self)={};
    $self->{date}=main::date(\%data);
    $self->{fr}=main::fr_addr(\%data);
    $self->{to}=main::to_addr(\%data);
    return undef unless $filt{$self->{fr}} or $filt{$self->{to}};
    my(%attach);
    tie %attach,'MultiHash';
    $self->{attach}=\%attach;
    %{$self->{attach}}=%{main::parts(\%data)};
    $self->{body}=main::body(\%data);
    eex($self);
    bless($self,$class);
    $self;
  };
  sub to {
    return $_[0]->{to};
  };
  sub fr {
    return $_[0]->{fr};
  };
  sub body {
    return $_[0]->{body};
  };
  sub date {
    return $_[0]->{date};
  };
  sub attach {
    return $_[0]->{attach};
  };
};
my %opt = (
  maildir => "mail",
  domain  => 'sms.org',
  me      => '6034000820,6037573283,6037620273',
  areas   => '734,603',
);

my @me_numbers  = split /,/, $opt{me};
my @keep_areas  = split /,/, $opt{areas};
my %is_me       = map { $_ => 1 } @me_numbers;

# ------------------------------------------------------------------ helpers --
my(%norm);
END {
  my($norm)=encode_json(\%norm);
  path("norm.json")->spew($norm);
};
sub normalize {
  # Collapse any phone number to bare 10 digits.
  # Handles: +16035551234  16035551234  (603)555-1234  603.555.1234  etc.
  my($i,$o);
  local ($_) = @_;
  $i="$_";
  if(defined($_)){
    s/[^\d]//g;          # strip everything non-digit
    s/^1(\d{10})$/$1/;   # strip leading country code 1 if present
  } else {
    $_="";
  };
  #$_='' unless 10==length;
  $o="$_";
  $norm{$i}=$o;
}
sub fr_addr {
  my($a);
  if(defined($a=$_[0]->{mms_addresses})){
    for(@$a){
      next unless $_->{type}==137;
      $a=normalize($_->{address}) ;
      return $a;
    }; 
  } elsif( $_->{type}==1 ) {
    return normalize($_[0]->{address});
  } else {
    return "16034000820";
  };
};
sub to_addr {
  my($a);
  if(defined($a=$_[0]->{mms_addresses})){
    for(@$a){
      next unless $_->{type}==151;
      $a=normalize($_->{address}) ;
      return $a;
    }; 
  } elsif( $_->{type}==2 ) {
    return normalize($_[0]->{address});
  } else {
    return "16034000820";
  };
};

sub is_me       { $is_me{ normalize($_[0]) // '' } }
sub is_wanted   {
  my $n = normalize($_[0]);
  return 0 unless length($n) == 10;
  my $area = substr($n, 0, 3);
  return 1 if $filt{$n};
  return 0;
  #  return grep { $_ eq $area } @keep_areas;
}
sub phone_addr {
  my ($raw, $label) = @_;
  return normalize($raw);
}
