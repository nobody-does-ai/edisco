sub Path::Tiny::md5slurp {
  my($path)=shift;
  my($hash)=shift;
  if(length($hash)!=32 or $hash!~m{^[0-9a-f]+$}) {
    die "invalid hash";
  };
  my($file)=$path->child($hash);
  my $text=$file->slurp;
  die "hash-mismatch" unless md5_str($text);
  return $text;
};
exit(main(@ARGV));
die "NONE SHALL PASS!";
sub rfc2822_date_from_ms {
  my ($ms) = @_;
  $ms ||= 0;
  my $t = int($ms / 1000);
  return serdate($t);
#      return strftime("%a, %d %b %Y %H:%M:%S %z", localtime($t));
}
sub safe_maildir_name {
  my ($ms,$type) = @_;
  confess unless defined ${type};
  my($res)=join(".",$ms,$type,$opt{domain});
  #eex( [$ms,$type,$res] );
  return $res;
}

sub write_maildir_message {
  my (%m) = @_;
  confess unless length $m{type};
  my $fn  = safe_maildir_name($m{date_ms},$m{type});
  my $tmp = $maildir->child('tmp')->mkdir->child($fn);
  my $new = $maildir->child('new')->mkdir->child($fn);
  $tmp->spew_utf8($m{raw});
  $tmp->move($new);
}

sub mk_addr {
  my ($label, $kind) = @_;
  $label ||= $opt{me};
  $label =~ s/^\s+|\s+$//g;

  # Phone-ish -> sms+NNN@domain
  if ($label =~ /^\+?\d[\d\-\s\(\)]+$/) {
    (my $norm = $label) =~ s/[^\d\+]+//g;
    $norm =~ s/^\+//;
    return qq{"$label" <sms+$norm\@$opt{domain}>};
  }

  # Already email-ish
  return qq{"$label" <$label>} if $label =~ /\@/;

  # Fallback
  return qq{"$label" <$kind\@$opt{domain}>};
}

sub emit_plain_email {
  my (%m) = @_;
  my $date = rfc2822_date_from_ms($m{date_ms});
  my $mid  = sprintf("<%s\@%s>", $m{date_ms}, $opt{domain});

  my $body = $m{body} // '';
  $body =~ s/\r\n/\n/g;
  $body =~ s/\r/\n/g;

  my @h;
  push(@h,"From: $m{from}") if defined $m{from};
  push(@h,"To: $m{to}") if defined $m{to};
  push(@h,"CC: $m{cc}") if defined $m{cc};
  push(@h,"Date: $date");
  push(@h,"Message-Id: $mid");
  push(@h,"Subject: $m{subject}") if defined $m{subject};
  push @h, @{$m{x_headers}} if $m{x_headers};

  return join("\n", @h, "", $body, "");
}

sub ext_from_ct {
  my ($ct) = @_;
  return 'jpg'  if $ct =~ m{^image/jpeg}i;
  return 'png'  if $ct =~ m{^image/png}i;
  return 'gif'  if $ct =~ m{^image/gif}i;
  return 'webp' if $ct =~ m{^image/webp}i;
  return 'mp4'  if $ct =~ m{^video/mp4}i;
  return '3gp'  if $ct =~ m{^video/3gpp}i;
  return 'vcf'  if $ct =~ m{vcard}i;
  return 'smil' if $ct =~ m{smil}i;
  return 'txt'  if $ct =~ m{^text/}i;
  return 'bin';
}

# Minimal base64 decode (no extra deps). Good enough.
sub b64_decode {
  my ($s) = @_;
  return '' unless defined $s && $s ne '';
  $s =~ s/\s+//g;
  my %t; my $i=0;
  $t{$_} = $i++ for ('A'..'Z','a'..'z',0..9,'+','/');
  my $out = '';
  my @c = split //, $s;
  while (@c) {
    my $a = shift @c; my $b = shift @c; my $c1 = shift @c; my $d = shift @c;
    last unless defined $d;
    my $pa = ($a eq '=') ? 0 : $t{$a};
    my $pb = ($b eq '=') ? 0 : $t{$b};
    my $pc = ($c1 eq '=') ? 0 : $t{$c1};
    my $pd = ($d eq '=') ? 0 : $t{$d};
    my $n  = ($pa<<18) | ($pb<<12) | ($pc<<6) | $pd;
    $out  .= chr(($n>>16)&255);
    $out  .= chr(($n>>8)&255)  if $c1 ne '=';
    $out  .= chr($n&255)       if $d  ne '=';
  }
  return $out;
}

sub save_attachment_blob {
  my (%a) = @_;
  my $tag = $a{date_ms};
  my $ext = $a{ext} || 'bin';
  my $fn  = "att.$tag.$ext";
  my $p   = $attdir->child($fn);
  return 0 if($p->exists);
  if (defined $a{bytes} && length $a{bytes}) {
    my $bytes = 
    $p->spew_raw(b64_decode($a{bytes}));
    return 1;
  }
  if (defined $a{text} && $a{text} ne '') {
    $p->spew_utf8($a{text});
    return 1;
  }
  return 0;
}

sub html_to_text {
  my ($html) = @_;
  return '' unless defined $html && $html ne '';
  my $dom = Mojo::DOM->new($html);
  my $t = $dom->all_text // '';

  $t =~ s/\r\n/\n/g;
  $t =~ s/\r/\n/g;
  $t =~ s/[ \t]+\n/\n/g;
  $t =~ s/\n{3,}/\n\n/g;
  return $t;
};
sub do_sms(@) {
  local(@_)=@_;
  for my $sms (@_) {
    local($_) = $sms->{'address'};
    my $date = $sms->{'date'};
    my $type = $sms->{'type'};
    my $body = $sms->{'body'};
    die if m{~};
    if(9>length) {
      next;
    } elsif( m{\@} ) {
      next;
    } else {
      next unless m{734};
      s{^[+1]+}{};
    };
    my ($from, $to, $subj);
    if ($type == 1) { # inbox
      $from = mk_addr($_, 'sms');
      $to   = mk_addr($opt{me}, 'me');
    } elsif ($type == 2) { # sent
      $from = mk_addr($opt{me}, 'me');
      $to   = mk_addr($_, 'sms');
    } else {
      $from = mk_addr($_, 'sms');
      $to   = mk_addr($opt{me}, 'me');
      die "from: $from to: $to";
    }
    $subj = "SMS ($type) $_";
    my @xh = (
      "X-SMS-Address: $_",
      "X-SMS-Type: $type",
      "X-SMS-Date-MS: $date",
    );
    my $raw = emit_plain_email(
      date_ms   => $date,
      from      => $from,
      to        => $to,
      subject   => $subj,
      body      => $body,
      x_headers => \@xh,
    );
    write_maildir_message(date_ms => $date, raw => $raw, type=>'sms');
  }
};
sub do_mms {
  for my $mms (@_) {
    local($_)    = $mms->{'address'};
    my $date    = $mms->{'date'};
    my $msg_box = $mms->{'msg_box'};
    my $subj0   = $mms->{'sub'};
    my ($from, $to, $subj,$cc);
     
    if ($msg_box == 1) { # inbox
      local($_,@_)=split(m{~});
      $_=shift if m{603};
      $from = mk_addr($_, 'mms');
      $to   = mk_addr($opt{me}, 'me');
      $cc   = mk_addr(shift, 'mms') if @_;
      $subj = $subj0 if length $subj0;
    } elsif ($msg_box == 2) { # sent
      $from = mk_addr($opt{me}, 'me');
      #eex $from;
      local($_,@_)=split(m{~});
      $to   = mk_addr($_, 'mms');
      if(@_) {
        $cc = mk_addr(shift,'mms');
      };
      
      $subj = ($subj0 ne '' ? $subj0 : "MMS to $_");
    } else {
      die if m{~};
      $from = mk_addr($_, 'mms');
      die if $from =~ m{~};
      #seex $from;
      $to   = mk_addr($opt{me}, 'me');
      $subj = ($subj0 ne '' ? $subj0 : "MMS ($msg_box) $_");
    }
    next if $from =~ m{\@rcs.google.com};
    next if $to =~ m{\@rcs.google.com};

    my @xh = (
      "X-MMS-Address: $_",
      "X-MMS-Msg-Box: $msg_box",
      "X-MMS-Date-MS: $date",
    );

    my $text_plain = '';
    my $text_html  = '';

    my $att_count = 0;
    my @part_summaries;
    for my $part (@{$mms->{parts}}) {
      my $ct = $part->{'ct'} // '';
    
      # Collect text bodies
      if ($ct eq 'text/plain') {
        my $t = $part->{'text'} // '';
        $text_plain .= ($text_plain eq '' ? '' : "\n\n") . $t if $t ne '';
        next;
      }
      if ($ct eq 'text/html') {
        my $h = $part->{'text'} // '';
        $text_html .= ($text_html eq '' ? '' : "\n\n") . $h if $h ne '';
        next;
      }

      # Summarize part for no-text cases (and for debugging)
      my $name = $part->{'name'}
      // $part->{'filename'}
      // $part->{'fn'}
      // '';
      my $sz   = $part->{'data_size'}
      // $part->{'size'}
      // '';

      my $sum = ($ct ne '' ? $ct : 'unknown/unknown');
      $sum .= " name=$name" if $name ne '';
      $sum .= " size=$sz"   if $sz ne '';
      push @part_summaries, $sum;

      # Save attachments (best effort)
      my $data_b64 = $part->{'data'}; # typically base64 for binary
      my $text     = $part->{'text'}; # sometimes textual payload
      my $ext      = ext_from_ct($ct);

      my $saved = 0;
      if (defined($data_b64) && $data_b64 ne '') {
        $saved = save_attachment_blob(date_ms => $date, ext => $ext, bytes => $data_b64);
      } else {
        $saved = save_attachment_blob(date_ms => $date, ext => $ext, text => $text);
      }

      $att_count++ if $saved;
    }

    # Build the grep-friendly body
    my $body = '';

    if ($text_plain ne '') {
      $body = $text_plain;
    }
    elsif ($text_html ne '') {
      my $txt = html_to_text($text_html);
      $body  = "[MMS: html body]\n\n";
      $body .= ($txt ne '' ? $txt : "(html present, but produced no text)") . "\n";
      $body .= "\n----BEGIN HTML----\n$text_html\n----END HTML----\n";
    }
    else {
      $body  = "[MMS: no text content]\n";
      $body .= "Parts:\n";
      if (@part_summaries) {
        $body .= join("", map { "  - $_\n" } @part_summaries);
      } else {
        $body .= "  - (no parts metadata)\n";
      }
    }

    if ($att_count) {
      $body .= "\n[Attachments saved: $att_count]\n";
    }
    next;
    my $raw = emit_plain_email(
      date_ms   => $date,
      from      => $from,
      to        => $to,
      subject   => $subj,
      body      => $body,
      type      => "mms",
      x_headers => \@xh,
      type => "mms",
    );

    write_maildir_message(date_ms => $date, raw => $raw, type=> 'mms');
  }
}
use Path::Tiny;
sub Path::Tiny::ext {
  local($_)=shift;
  my($dir)=$_->parent;
  my($oext)=m{([.][^/.]+)$};
  my($next)=shift;
  s{^[.]}{} for $next;
  my($base)=$_->basename($oext);
  my($path)=path("$dir/$base.$next");
  $path;
};
sub clean {
  local(@_)=shift;
  while(@_) {
    local($_)=shift;
    if(ref($_)eq'REF'){
      $_=$$_;
    };
    if(ref($_)eq'HASH'){
      my($hash)=$_;
      for(keys %$hash) {
        next if defined($_) and $_ ne 'null';
        delete $hash->{$_};
      };
      push(@_,map { \$_ } values %$_);
    } elsif (ref($_)eq'ARRAY') {
      push(@_,map { \$_ } @$_);
    } elsif (ref($_)eq'SCALAR') {
    }
  };
};
my(%n);
sub rconvert {
  my($n)=shift;
  my($a)=refaddr($n);
  $n{$a}=[$n];
  for($n->childNodes()){
    if(ref($_) ne "XML::LibXML::Text"){
      push(@{$n{$a}},refaddr($_));
      rconvert($_);
    };
  };
};
my(%skip);
BEGIN {
  $skip{data}=1;
  $skip{creator}=1;
  $skip{protocol}=1;
  $skip{status}=1;
  $skip{date_sent}=1;
  $skip{exp}=1;
  $skip{locked}=1;
  $skip{m_cls}=1;
  $skip{read}=1;
  $skip{seen}=1;
  $skip{rr}=1;
  $skip{tr_id}=1;
  $skip{readable_date}=1;
};
my(%counts);
END {
  eex(\%counts);
};
our(%self);
our(%seen);
sub convert {
  local($_)=shift;
  local(*self)=shift;
  for($_->attributes()) {
    my($n,$v)=($_->getName(),$_->getValue());
    next if $v eq "null";
    next if $v eq "(Unknown)";
    next if $v =~ m{^proto:};
    next if $skip{$n};
    $self{$n}=$v;
  };
  for($_->childNodes()){
    local(@_)=split m{::}, ref;
    next if $_[$#_] eq "Text";
    next if $_[$#_] eq "Comment";
    my($nodeName)=$_->nodeName();
    die "conflict" unless ref($self{$nodeName}//=[]) eq 'ARRAY';
    push(@{$self{$nodeName}},convert($_,{}));
  };
  for my $s(qw(part addr)) {
    my($p)="${s}s";
    if(exists $self{$p}){
      if(%{$self{$p}[0]}) {
        die pp(\%self) unless exists $self{$p}[0]{$s};
        $self{$p}=$self{$p}[0]{$s};
        delete $counts{$s};
      } else {
        delete $self{$p};
      };
    };
  };
  for(keys %self) {
    $counts{$_}{0+@{$self{$_}}}++ if ref($self{$_}) eq 'ARRAY';
  };
  \%self;
};
my(%addr);
END {
  eex(\%addr);
};
my (%doc);
sub main {
  my($coder)=JSON::XS->new()->pretty(1);
  GetOptions(
    'in=s'      => \$opt{in},
    'maildir=s' => \$opt{maildir},
    'me=s'      => \$opt{me},
    'domain=s'  => \$opt{domain},
  ) or die "usage: $0 --in sms.xml --maildir /path/to/Maildir [--me me\@local] [--domain local]\n";

  for my $in(map { path($_) } glob("xml/sms-*.xml")) {
    next if -e "$in.xml";
#        my(@files);
    for (qw(tmp new cur)) {
      local($_)=[$_,$maildir->child($_)->mkdir];
      next if($_->[0] eq 'tmp');
      $_=$_->[1];
    }
    my $parser = XML::LibXML->new( recover => 1, no_network => 1, huge=>1, ForceArray=>1);
    my @lines=path($in)->lines;
    $_="";
    $DB::single=1;
    my($doc)=$parser->load_xml(string=>join("",@lines));
    convert($doc,\%doc);
    $doc=\%doc;
    @_=grep { $_->{address} =~ /^[1+]*734/ } map { @{$_->{sms}}, @{$_->{mms}} } @{$doc->{smses}};
    say scalar(@_);
    for my $msg(@_) {
      $_=$msg->{address};
      for(split m{~}) {
        push(@{$addr{$_}},$msg);
      };
    };
#        eex( keys %$doc );
#        my(@sms)=@{$doc->{sms}};
#        say 0+@sms;
#        my(@mms)=@{$doc->{mms}};
#        say 0+@mms;
#        #eex( scalar(@sms), scalar(@mms) );
#        clean($_) for @sms,@mms;
#        do_sms($_) for(@sms);
#        do_mms($_) for(@mms);
  }
  eex "Done.";
  eex "Maildir: $maildir";
  eex "Attachments dir: $attdir";
}
