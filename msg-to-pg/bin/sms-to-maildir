sub me_addr { qq{"me" <} . $me_numbers[0] . qq{\@$opt{domain}>} }

# Map MMS content-types to file extensions.
my %CT_EXT = (
  'image/jpeg'      => 'jpg',
  'image/jpg'       => 'jpg',
  'image/png'       => 'png',
  'image/gif'       => 'gif',
  'image/webp'      => 'webp',
  'image/bmp'       => 'bmp',
  'image/tiff'      => 'tif',
  'video/mp4'       => 'mp4',
  'video/3gpp'      => '3gp',
  'video/3gpp2'     => '3g2',
  'video/quicktime' => 'mov',
  'video/webm'      => 'webm',
  'audio/mpeg'      => 'mp3',
  'audio/mp4'       => 'm4a',
  'audio/amr'       => 'amr',
  'audio/ogg'       => 'ogg',
  'audio/wav'       => 'wav',
  'application/pdf' => 'pdf',
  'text/vcard'      => 'vcf',
  'text/x-vcard'    => 'vcf',
);

sub ct_ext {
  my ($ct) = @_;
  $ct = lc($ct // '');
  $ct =~ s/;.*//;   # strip parameters like "; charset=utf-8"
  $ct =~ s/\s+//g;
  return $CT_EXT{$ct} // 'bin';
}

# Save a binary attachment to inc/<md5>.<ext>; hard-link if already present.
# Returns the bare filename, or undef if data is absent/null.
sub save_attachment {
  my ($incdir, $ct, $b64) = @_;
  return undef unless defined $b64 && $b64 ne '' && $b64 ne 'null';
  my $bytes = decode_base64($b64);
  return undef unless length($bytes);
  my $md5  = md5_hex($bytes);
  my $ext  = ct_ext($ct);
  my $fn   = "$md5.$ext";
  my $dest = $incdir->child($fn);
  unless (-e $dest) {
    # Write to a temp file first, then rename atomically.
    my $tmp = $incdir->child("$fn.tmp");
    $tmp->spew_raw($bytes);
    $tmp->move($dest);
  }
  return $fn;
}

sub rfc2822 {
  my ($ms) = @_;
  return strftime("%a, %d %b %Y %H:%M:%S +0000", gmtime(int(($ms||0)/1000)));
}

sub emit_email {
  my (%m) = @_;
  my $body = $m{body} // '';
  $body =~ s/\r\n/\n/g;
  $body =~ s/\r/\n/g;
  $body =~ s/\n+$//;
  $body .= "\n";
  my @h;
  push @h, "From: $m{from}"       if defined $m{from};
  push @h, "To: $m{to}"           if defined $m{to};
  push @h, "CC: $m{cc}"           if defined $m{cc};
  push @h, "Date: $m{date}";
  push @h, "Message-Id: $m{mid}";
  push @h, "Subject: $m{subject}" if defined $m{subject};
  push @h, @{ $m{xhdrs} }         if $m{xhdrs};
  return join("\n", @h, "", $body);
}

sub write_message {
  my ($maildir, $ms, $type, $mtype, $raw) = @_;
  # Include m_type in filename to avoid collisions between delivery-receipt
  # shells (m_type=128) and the actual message record (m_type=132) that can
  # share the same millisecond timestamp.
  my $fn  = join('.', $ms, $type, $mtype, $opt{domain});
  my $tmp = $maildir->child('tmp')->mkdir->child($fn);
  my $new = $maildir->child('new')->mkdir->child($fn);
  $maildir->child('cur')->mkdir;
  $tmp->spew_utf8($raw);
  $tmp->move($new);
}

# ----------------------------------------------------------------- SMS loop --

sub handle_sms {
  my ($maildir, $sms_list) = @_;
  my $written = 0;

  for my $sms (@$sms_list) {
    my $raw_addr = $sms->{address} // '';
    next if $raw_addr =~ /\@/;
    next unless is_wanted($raw_addr);

    my $norm    = normalize($raw_addr);
    my $date_ms = $sms->{date}  // 0;
    my $type    = $sms->{type}  // 0;   # 1=inbox 2=sent
    my $body    = $sms->{body}  // '';
    my $contact = $sms->{contact_name} // '';
    $contact = '' if $contact eq '(Unknown)';

    my ($from, $to, $subj);
    if ($type == 1) {
      $from = phone_addr($norm, $contact);
      $to   = me_addr();
      $subj = "SMS from " . ($contact || $norm);
    } else {
      $from = me_addr();
      $to   = phone_addr($norm, $contact);
      $subj = "SMS to " . ($contact || $norm);
    }

    my $raw = emit_email(
      from    => $from,
      to      => $to,
      date    => rfc2822($date_ms),
      mid     => sprintf("<%s.sms\@%s>", $date_ms, $opt{domain}),
      subject => $subj,
      body    => $body,
      xhdrs   => [
        "X-SMS-Address: $norm",
        "X-SMS-Type: $type",
        "X-SMS-Date-MS: $date_ms",
      ],
    );

    write_message($maildir, $date_ms, 'sms', 0, $raw);
    $written++;
  }
  return $written;
}

# ----------------------------------------------------------------- MMS loop --

sub handle_mms {
  my ($maildir, $mms_list) = @_;
  my $written = 0;

  for my $mms (@$mms_list) {
    my $raw_addr = $mms->{address} // '';
    next if $raw_addr =~ /\@rcs\.google\.com/;
    next if $raw_addr =~ /\@/;

    my $date_ms = $mms->{date}    // 0;
    my $msg_box = $mms->{msg_box} // 0;   # 1=inbox 2=sent
    my $contact = $mms->{contact_name} // '';
    $contact = '' if $contact eq '(Unknown)';

    # Build participant list from <addrs><addr ...> entries.
    # XMLin gives us: addrs => [ { addr => [ {address=>..., type=>...}, ... ] } ]
    my @parts;
    if (ref $mms->{addrs} eq 'ARRAY') {
      for my $ag (@{ $mms->{addrs} }) {
        next unless ref $ag eq 'HASH' && ref $ag->{addr} eq 'ARRAY';
        for my $a (@{ $ag->{addr} }) {
          next unless ref $a eq 'HASH';
          my $n = normalize($a->{address} // '');
          next unless length($n) == 10;
          push @parts, { norm => $n, type => ($a->{type} // '') };
        }
      }
    }
    # Fall back to tilde-separated top-level address
    unless (@parts) {
      for my $a (split /~/, $raw_addr) {
        my $n = normalize($a);
        push @parts, { norm => $n, type => '' } if length($n) == 10;
      }
    }

    # Must have at least one wanted non-self participant
    my @others = grep { !$is_me{$_->{norm}} } @parts;
    next unless grep { is_wanted($_->{norm}) } @others;

    # Extract text and binary attachments from parts.
    # XMLin: parts => [ { part => [ {ct=>..., text=>..., data=>...}, ... ] } ]
    my $incdir = $maildir->child('inc')->mkdir;
    my $body = '';
    my @att_files;   # bare filenames in inc/
    for my $pg (@{ $mms->{parts} // [] }) {
      next unless ref $pg eq 'HASH';
      my $plist = ref $pg->{part} eq 'ARRAY' ? $pg->{part} : [];
      for my $part (@$plist) {
        next unless ref $part eq 'HASH';
        my $ct   = $part->{ct}   // '';
        my $text = $part->{text} // '';
        $text = '' if $text eq 'null';
        my $data = $part->{data} // '';
        $data = '' if $data eq 'null';
        if ($ct eq 'text/plain' && $text ne '') {
          $body .= ($body eq '' ? '' : "\n\n") . $text;
        } elsif ($ct =~ m{application/smil}i) {
          # discard -- layout wrapper only
        } elsif ($ct =~ m{text/}i) {
          # other text subtypes: treat as body if non-empty
          $body .= ($body eq '' ? '' : "\n\n") . $text if $text ne '';
        } elsif ($data ne '') {
          my $fn = save_attachment($incdir, $ct, $data);
          push @att_files, $fn if defined $fn;
        }
      }
    }
    # Skip entirely if there is nothing to say -- these are typically
    # delivery-receipt shells (m_type=128) that duplicate a real message.
    next if $body eq '' && !@att_files;

    # Build From/To/CC
    my $primary = $others[0]{norm};
    my $label   = $contact ne '' ? $contact : $primary;

    my ($from, $to, $cc);
    if ($msg_box == 2) {
      $from = me_addr();
      $to   = phone_addr($primary, $label);
      if (@others > 1) {
        $cc = join(', ', map { phone_addr($_->{norm}) } @others[1..$#others]);
      }
    } else {
      $from = phone_addr($primary, $label);
      $to   = me_addr();
      if (@others > 1) {
        $cc = join(', ', map { phone_addr($_->{norm}) } @others[1..$#others]);
      }
    }

    my $subj = ($msg_box == 2 ? "MMS to " : "MMS from ") . $label;

    my $raw = emit_email(
      from    => $from,
      to      => $to,
      (defined $cc ? (cc => $cc) : ()),
      date    => rfc2822($date_ms),
      mid     => sprintf("<%s.mms\@%s>", $date_ms, $opt{domain}),
      subject => $subj,
      body    => $body,
      xhdrs   => [
        "X-MMS-Address: $raw_addr",
        "X-MMS-Msg-Box: $msg_box",
        "X-MMS-Date-MS: $date_ms",
        "X-MMS-Type: " . ($mms->{m_type} // ''),
        (map { "X-Attachment: $_" } @att_files),
      ],
    );

    my $mtype = $mms->{m_type} // 0;
    write_message($maildir, $date_ms, 'mms', $mtype, $raw);
    $written++;
  }
  return $written;
}

our %msg;
my($stime);
BEGIN {
  $stime=time;
};
sub date {
  my($date)=$_[0]->{date};
  $date=int($date/1000) if($date>$stime);
  die unless defined $date;
  serdate($date);
};
our(@msg);
sub main {
  my $maildir = path($opt{maildir});
  $maildir->mkdir;
  my @inputs=(glob('xml/sms-*.xml'));
  for my $infile (@inputs) {
    my $abs = path($infile)->realpath;
    warn "Parsing $abs ...\n";
    use XML::LibXML;
    use XML::LibXML::Simple qw(XMLin);

    my $parser = XML::LibXML->new(huge => 1);
    my $doc    = $parser->parse_file($abs);
    
    my $data = XMLin(
      $doc,
      KeepRoot   => 1,
      KeyAttr    => [],
      ForceArray => [qw( sms mms part addr parts addrs )],
    );
    my $root = $data->{smses} or die "Expected <smses> root in $abs\n";
    for(@{$root->{sms}},@{$root->{mms}}){
      my($msg)=Msg->new($_);
      next unless defined $msg;
      $msg{$msg->date}{$msg->fr}{$msg->to}=$msg;
    };
    eex( { msgs=>0+(keys %msg) } );
  }
  for my $infile( glob("json/*.json")) {
    warn "Parsing $infile ...\n";
    my $data = decode_json(path($infile)->slurp);
    for(@$data){
      $_->{archived}=join("",$_->{archived});
      my($msg)=Msg->new($_);
      next unless defined $msg;
      $msg{$msg->date}{$msg->fr}{$msg->to}=$msg;
    };
  };
  eex(\%msg);
  exit(0);
  my($total_sms)=0;
  my($total_mms)=0;
  our(@msg);
  for my $date(sort keys %msg) {
    local(*msg)=$msg{$date};
    say "date: ", $date;
    say refaddr(\%msg);
    for my $fr_addr(sort keys %msg) {
      local(*msg)=$msg{$fr_addr};
      for my $to_addr(sort keys %msg) {
        local(*msg)=$msg{$to_addr};
        next unless $filt{fr_addr(\%msg)} or $filt{to_addr(\%msg)};
        eex(\%msg);
      }
    }
  };
  path("msgs.json")->spew(join("\n",@msg));
  warn "Done. SMS=$total_sms MMS=$total_mms  Maildir=$opt{maildir}\n";
}
main();
