#!/usr/bin/perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use common::sense;
use autodie;
use Nobody::Util;
use Nobody::PP;
our(@VERSION) = qw( 0 1 0 );
sub main;
main;
sub main {
  my($re);
  open(STDOUT,"|sort");
  my($f)=1;
  for(@ARGV) {
    my($file)=$_;
    if(!defined($re)){
      $re=qr{$_}i;
    } elsif(-d) {
      my($path)=path($_);
      push(@ARGV,grep { !m{/[.]} } $path->children );
    } elsif(-f) {
      my($path)=path($_);
      my(@lines)=$path->lines;
      $.=0;
      for(@lines) {
        ++$.;
        chomp;
        last unless /\S/;
        my($full)=$_;
        next unless s/^($re:)\s*//;
        say "1: $1";
        my($head)=lc($1);
        my(@head)=$_;
        @head = map { split m{,\s+} } @head;
        @head = map { local(@_)=m{^.*<\s*(.*)\s*>.*}; @_=$_ unless @_; @_; } @head;
        eex([$full,$head, \@head]);
#            map { "$head $_" } map { split }
#            say for @head;
#            for(split m{\s*"[^"]*"\s*}) {
#              if($f) {
#              } else {
#              };
#            }
      };
    } elsif ( m{^-f$} ) {
      $f=!$f;
    } else {
      system("ls -l $_>&2");
    };
  }
  close(STDOUT);
};
our(%hand);
