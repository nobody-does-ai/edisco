#!/usr/bin/perl
use strict;
use warnings;
use Nobody::Util;
use Compress::Raw::Zlib;

my $compressed = path(shift)->slurp_raw;

my ($inflate, $status) = Compress::Raw::Zlib::Inflate->new(
    -WindowBits => -MAX_WBITS,   # negative = raw deflate, no headers
);

die "Inflate->new failed: $status\n"
    unless $status == Z_OK;

my $out = '';
$status = $inflate->inflate($compressed, $out);

die "inflate failed: $status\n"
    unless $status == Z_STREAM_END || $status == Z_OK;

print $out;
