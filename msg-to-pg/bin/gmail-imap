#!/usr/bin/env perl
use strict;
use warnings;
use common::sense;
use Nobody::Util;
use Maildir;
BEGIN {
  local(@_) = "$Dir";
  s{dir/*$}{} for @_;
};
use Nobody::JSON qw(json);
use Mail::IMAPClient;
use IO::Socket::SSL;
use Digest::MD5 qw(md5_hex);
use Email::MIME;
BEGIN {
  $Email::MIME::ContentType::STRICT_PARAMS =0;
};
#gmail/rich.paul.freeman gmail/rich.private.paul
push(@ARGV, qw( gmail/rich.freeman.paul )) unless @ARGV;
sub main(@);
main(@ARGV);
sub main(@) {
  my $pass_entry = resolve_pass_entry(splice(@_,rand(@_),1));
  my $config = load_account_config($pass_entry);

  my $dir = path($config->{maildir});
  $dir->child($_)->mkdir for qw(cur new tmp);
  my($idx_file)=$dir->child("index.json");
  $idx_file->spew("{}") unless $idx_file->exists;
  my $idx = json->load($idx_file);
  $idx={} unless ref($idx);
  eex($idx);
  $idx->{version} //= 1;
  $idx->{folder}  //= $config->{target_label};
  $idx->{uidvalidity} //= undef;
  $idx->{messages} //= {};
  $idx->{uids}     //= {};

  my $imap = imap($config);
  die "IMAP session was not created\n" unless $imap;

  clean_maildir_cur($idx, $dir->child('cur'));
  json->save($idx_file, $idx);

  {
    my $folder = $config->{target_label};
    log_msg("Using pass entry $pass_entry for $config->{user}");
    log_msg("Selecting folder: $folder");
    $imap->select($folder) or die "Could not select $folder: $@";

    my $uv = eval { $imap->uidvalidity($folder) };
    $idx->{uidvalidity} = $uv if defined $uv;

    log_msg(@{$config->{targets}} ? "Starting individual term searches..." : "No targets configured; searching ALL messages...");

    my @all_uids;
    die "no targets!" unless @{$config->{targets}};
    if (@{$config->{targets}}) {
      foreach my $term (@{$config->{targets}}) {
        my $query = qq(TEXT "$term");
        my @results = $imap->search($query);
        log_msg(sprintf("Term [%s]: %d results", $term, scalar @results));
        push(@all_uids, @results);
      }
    } else {
      die "no targets!";
#          @all_uids = $imap->search('ALL');
#          log_msg(sprintf("ALL: %d results", scalar @all_uids));
    }

    @all_uids = uniq(@all_uids);
    log_msg(sprintf("Total unique UIDs to process: %d", scalar @all_uids));

    my @todo_uids = grep { !defined $idx->{uids}{$_} } @all_uids;
    log_msg(sprintf("UIDs not present in index (to fetch): %d", scalar @todo_uids));

    my $added = 0;

    for my $uid (@todo_uids) {
      my $raw = $imap->message_string($uid);
      unless ($raw) {
        warn "Fetch failed: UID $uid: $@";
        next;
      }

      my $h = parse_headers_from_raw($raw);
      my $mid = $h->{'message-id'};

      unless ($mid) {
        log_msg("WARNING: UID $uid has no Message-ID; skipping (md5=" . md5_hex($raw) . ").");
        next;
      }

      my $cooked = cook_message($raw, $dir->child('inc'));
      my $md5 = md5_hex($cooked);
      my $base = mail_filename($md5);
      my $cur_target = $dir->child('cur', $base);
      my $new_target = $dir->child('new', $base);

      if (defined $idx->{messages}{$mid}) {
        $idx->{uids}{$uid} = $mid;
        $idx->{messages}{$mid}{uid} //= $uid;
        if ($cur_target->exists || $new_target->exists) {
          next;
        }
        log_msg("WARNING: index has $mid but cur/$base is missing; restaging message from UID $uid.");
      }

      unless ($cur_target->exists || $new_target->exists) {
        write_maildir_message($dir, $cooked);
      }

      $idx->{messages}{$mid} = {
        md5     => $md5,
        uid     => $uid,
        date    => $h->{date},
        from    => $h->{from},
        to      => $h->{to},
        subject => $h->{subject},
      };
      $idx->{uids}{$uid} = $mid;
      $added++;
      json->save($idx_file, $idx) unless $added %10;
      log_msg("$added");
    }

    json->save($idx_file, $idx);

    clean_maildir_cur($idx,$dir->child('cur'));

    my $new_dir = $dir->child('new');
    my @staged = sort grep { -f $_ && $_->basename !~ /^\./ } $new_dir->children;

    my $promoted = 0;
    for my $p (@staged) {
      my $bn = $p->basename;
      my $raw = $p->slurp_raw;
      my $md5 = md5_hex($raw);
      my $canon = mail_filename($md5);

      if ($bn ne $canon) {
        log_msg("WARNING: new/$bn altered or renamed (md5 is $md5). Deleting and dropping index entries.");
        $p->remove;
        drop_messages_by_md5_filename($bn);
        next;
      }

      my $dest = $dir->child('cur', $bn);
      if ($dest->exists) {
        $p->remove;
        next;
      }

      $p->move($dest);
      $promoted++;
    }

    clean_maildir_cur($idx,$dir->child('cur'));
    json->save($idx_file, $idx);

    log_msg("Sync complete. $added new unique messages downloaded; $promoted promoted into cur/.");
  }

  $imap->logout if $imap && eval { $imap->IsConnected };
}
sub resolve_pass_entry {
  die "usage: resolve_pass_entry( arg )" unless @_==1;
  my ($arg) = @_;
  return $arg if defined($arg) && length($arg) && $arg =~ m{/};
  return "gmail/$arg" if defined($arg) && length($arg);
  return "gmail/rich.freeman.paul";
}

sub load_account_config {
  die "load_account_config( entry )" unless @_==1;
  my ($entry) = @_;
  my $raw = qx(pass show -- $entry);
  die "Failed to read pass entry $entry\n" if $? != 0;

  my $cfg = eval { json->decode($raw) };
  die "Invalid JSON in pass entry $entry: $@\n" if $@;
  die "Config in pass entry $entry must be a JSON object\n" unless ref($cfg) eq 'HASH';

  $cfg->{imap_server} //= 'imap.gmail.com';
  $cfg->{imap_port}   //= 993;
  $cfg->{target_label}  //= '[Gmail]/All Mail';
  $cfg->{pass} //= delete $cfg->{password} if exists $cfg->{password};
  $cfg->{targets} //= [];

  my @required = qw(user pass target_label maildir targets);
  for my $key (@required) {
    die "Missing required config key '$key' in pass entry $entry\n"
    unless exists($cfg->{$key});
  }

  die "Config key 'user' must be a non-empty string\n"
  unless defined($cfg->{user}) && !ref($cfg->{user}) && length($cfg->{user});
  die "Config key 'pass' must be a non-empty string\n"
  unless defined($cfg->{pass}) && !ref($cfg->{pass}) && length($cfg->{pass});
  die "Config key 'imap_server' must be a non-empty string\n"
  unless defined($cfg->{imap_server}) && !ref($cfg->{imap_server}) && length($cfg->{imap_server});
  die "Config key 'imap_port' must be numeric\n"
  unless defined($cfg->{imap_port}) && $cfg->{imap_port} =~ /\A\d+\z/;
  die "Config key 'target_label' must be a non-empty string\n"
  unless defined($cfg->{target_label}) && !ref($cfg->{target_label}) && length($cfg->{target_label});
  die "Config key 'maildir' must be a non-empty string\n"
  unless defined($cfg->{maildir}) && !ref($cfg->{maildir}) && length($cfg->{maildir});
  die "Config key 'targets' must be a JSON array\n"
  unless ref($cfg->{targets}) eq 'ARRAY';
  for my $term (@{$cfg->{targets}}) {
    die "Each target must be a non-empty string\n"
    unless defined($term) && !ref($term) && length($term);
  }

  if ($entry =~ m{\Agmail-imap/([^/]+)\z}) {
    die "Pass entry user '$1' does not match config user '$cfg->{user}'\n"
    unless $cfg->{user} eq $1;
  }

  return $cfg;
}

sub imap {
  die "usage: imap (cfg)" unless @_==1;
  my ($cfg) = @_;

  my $socket = IO::Socket::SSL->new(
    PeerAddr => $cfg->{imap_server},
    PeerPort => $cfg->{imap_port},
  ) or die "SSL socket failed: $@";

  my $imap = Mail::IMAPClient->new(
    User     => $cfg->{user},
    Password => $cfg->{pass},
    Socket   => $socket,
    Raw      => 1,
    Uid      => 1,
  ) or die "IMAP connection failed: $@";

  return $imap;
}

sub log_msg {
  my (@loc) = caller(0);
  say $loc[1], ":", $loc[2], ": ", sprintf("[%s] %s", serdate, "@_");
}

sub cook_message {
  my ($raw, $incdir) = @_;
  $incdir->mkdir;
  my $email = Email::MIME->new($raw);
  my $body = '';
  my @att_files;

  $email->walk_parts(sub {
    my $part = shift;
    return if $part->subparts;  # skip multipart containers
    my $ct = $part->content_type // '';
    $ct =~ s/;.*//;
    $ct = lc($ct);
    $ct =~ s/\s+//g;
    if ($ct eq 'text/plain') {
      my $text = eval { $part->body_str } // $part->body;
      $body .= ($body eq '' ? '' : "\n\n") . $text;
    } else {
      my $fn = save_attachment($incdir, $ct, $part->body);
      push @att_files, $fn if defined $fn;
    }
  });

  my $h = parse_headers_from_raw($raw);
  my $cooked = emit_email(
    from    => $h->{from},
    to      => $h->{to},
    date    => $h->{date},
    mid     => $h->{'message-id'},
    subject => $h->{subject},
    body    => $body,
    xhdrs   => [map { "X-Attachment: $_" } @att_files],
  );
  utf8::encode(my $bytes = $cooked);
  return $bytes;
}

sub parse_headers_from_raw {
  my ($raw) = @_;
  my %h;

  my ($hdr) = $raw =~ /\A(.*?\r?\n)\r?\n/s;
  $hdr //= $raw;
  $hdr =~ s/\r?\n[ \t]+/ /g;

  for my $field (qw(Message-ID Date From To Subject)) {
    if ($hdr =~ /^$field:\s*(.*?)\r?\n/im) {
      my $v = $1;
      $v =~ s/\s+$//;
      $h{lc($field)} = $v;
    }
  }

  if (defined $h{'message-id'}) {
    my $mid = $h{'message-id'};
    $mid =~ s/^\s*<//;
    $mid =~ s/>\s*$//;
    $mid =~ s/\s+$//;
    $h{'message-id'} = $mid;
  }

  return \%h;
}

sub rebuild_md5_manifest {
  my (@cur_dir) = @_;
  my $count = 0;
  while (@cur_dir) {
    my @lines;
    my $cur_dir = shift(@cur_dir);
    for my $p ($cur_dir->children) {
      if (-d $p) {
        push(@cur_dir, $p);
      } elsif (-f $p) {
        my $md5 = md5_hex($p->slurp_raw);
        push @lines, "$md5  " . $p->basename;
      }
    }
    my $manifest = @lines ? join("\n", @lines) . "\n" : "";
    $cur_dir->child('.md5')->spew_raw($manifest);
    $count += scalar(@lines);
  }
  return $count;
}

sub drop_message_by_mid {
  die "usage: drop_message_by_id (idx,mid)" unless @_==2;
  my ($idx,$mid) = @_;
  my $rec = $idx->{messages}{$mid} or return;
  my $uid = $rec->{uid};
  delete $idx->{uids}{$uid} if defined $uid;
  delete $idx->{messages}{$mid};
}


sub drop_messages_by_md5_filename {
  die "drop_messages_by_md5_filename(idx,fname_md5)" unless @_==1;
  my ($idx,$fname_md5) = @_;
  my $md5 = md5_from_filename($fname_md5) // return;
  for my $mid (keys %{$idx->{messages}}) {
    my $r = $idx->{messages}{$mid} || next;
    next unless defined $r->{md5} && $r->{md5} eq $md5;
    drop_message_by_mid($mid);
  }
}

sub clean_maildir_cur {
  die "clean_maildir_cur( idx,cur_dir )" unless @_==2;
  my ($idx,$cur_dir) = @_;
  my @paths = sort $cur_dir->children;

  for my $p (@paths) {
    next unless -f $p;
    my $bn = $p->basename;
    next if $bn =~ /^\./;

    my $raw = $p->slurp_raw;
    my $md5 = md5_hex($raw);
    my $canon = mail_filename($md5);

    if ($bn eq $canon) {
      next;
    }

    if (defined(md5_from_filename($bn)) && $bn ne $canon) {
      log_msg("WARNING: cur/$bn appears altered (md5 is $md5). Deleting and dropping index entries.");
      $p->remove;
      drop_messages_by_md5_filename($bn);
      next;
    }

    my $target = $cur_dir->child($canon);
    if ($target->exists) {
      log_msg("WARNING: cur/$bn renamed; canonical cur/$canon already exists. Deleting cur/$bn.");
      $p->remove;
    } else {
      log_msg("WARNING: cur/$bn renamed; restoring canonical name cur/$canon");
      $p->move($target);
    }
  }

  my %have = map { $_->basename => 1 } grep { -f $_ && $_->basename !~ /^\./ } $cur_dir->children;
  for my $mid (keys %{$idx->{messages}}) {
    my $r = $idx->{messages}{$mid} || next;
    my $m = mail_filename($r->{md5} // next);
    next if $have{$m};
    log_msg("WARNING: index references missing cur/$m for $mid; leaving index record intact.");
  }

  my $n = rebuild_md5_manifest($cur_dir);
  log_msg("Verified cur/ integrity and rebuilt .md5 ($n files).");
}
