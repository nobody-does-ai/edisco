#!/usr/bin/env perl
use strict;
use warnings;
use common::sense;
use Email::MIME;
use Path::Tiny;
use Digest::MD5 qw(md5_hex);

# Configuration
my $mail_root = path("./mail/dir");
my $att_root  = $mail_root->child("att");

# Ensure attachment shards 00-99 exist
$att_root->child(sprintf("%02d", $_))->mkpath for 0..99;

sub get_attachment_path {
    my ($filename) = @_;
    $filename =~ s/[^a-zA-Z0-9._-]/_/g;
    
    for my $i (0..99) {
        my $sub = sprintf("%02d", $i);
        my $target = $att_root->child($sub, $filename);
        return $target unless $target->exists;
    }
    return $att_root->child("00", time . "_" . $filename);
}

sub process_message {
    my ($file) = @_;
    my $raw = $file->slurp_raw;
    my $parsed = Email::MIME->new($raw);
    
    my @body_parts;
    my @attachments;

    $parsed->walk_parts(sub {
        my ($part) = @_;
        # parts() returns a list in list context; count parts to skip containers
        return if scalar($part->parts) > 1;

        my $type = $part->content_type // 'text/plain';
        my $disp = $part->header('Content-Disposition') // '';
        my $name = $part->filename // 'unnamed';

        # Standard Body Promotion: logic for finding the primary text content
        if ($type =~ m{text/plain}i && ($disp !~ /attachment/i || !@body_parts)) {
            push @body_parts, $part->body_str;
        }
        # HTML Conversion via links -dump
        elsif ($type =~ m{text/html}i && $disp !~ /attachment/i) {
            my $tmp = Path::Tiny->tempfile(SUFFIX => '.html');
            $tmp->spew_raw($part->body);
            my $dump = qx(links -dump $tmp);
            push @body_parts, "--- HTML DUMP ---\n$dump";
        }
        # Everything else is handled as an externalized attachment
        else {
            my $dest = get_attachment_path($name);
            $dest->spew_raw($part->body);
            push @attachments, $dest->relative($mail_root);
        }
    });

    # Rebuild the message as a simplified flat file
    my $content = join("\n\n", @body_parts);
    if (@attachments) {
        $content .= "\n\n--- ATTACHMENTS ---\n" . join("\n", @attachments) . "\n";
    }

    my $header_obj = $parsed->header_obj;
    my $new_msg = Email::MIME->create(
        header_str => [ map { $_ => $header_obj->header($_) } $header_obj->header_names ],
        parts      => [ $content ],
    );

    $file->spew_raw($new_msg->as_string);
}

log_msg("Flattening Maildir for grep...");
for my $f ($mail_root->child("cur")->children) {
    next if $f->is_dir;
    eval { process_message($f) };
    warn "Fail $f: $@\n" if $@;
}

sub log_msg { printf "[%s] %s\n", scalar localtime, shift; }