#!/usr/bin/perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use lib "lib";
use common::sense;
use autodie;
use Nobody::Util;
use JSON::PP;
use TsvUtil qw(group_find vert_sort words_merge);
use TsvFile;
use TsvDoc;
our(@VERSION) = qw( 0 1 0 );

sub is_num { ($_[0]//'') =~ m{^-?[\d,]*\.?\d+$} }
sub clean_num { my $n=shift//return undef; $n=~s/,//g; $n }

sub parse_xact {
  my($text)=join(' ', map{$_->text//''}@_);
  my(@tok)=split(/\s+/,$text);
  return unless @tok >= 2;
  my($date)=$tok[0];
  return unless $date =~ m{^\d{1,2}/\d{2}/\d{4}$};
  my($amount)=$tok[-1];
  return unless is_num($amount);
  my($desc)=join(' ',@tok[1..$#tok-1]);
  return { date=>$date, desc=>$desc, amount=>clean_num($amount) };
};

sub parse_ivst {
  my(@w)=@_;
  my(@nums);
  while(@w && is_num($w[-1]->text)){
    unshift @nums, clean_num((pop @w)->text);
  };
  return unless @nums >= 3;
  my($desc)=join(' ', map{$_->text//''}@w);
  return unless $desc =~ /\w/;
  return if $desc =~ /^Total\b/i;
  my($num,$sprice,$total,$basis,$unreal);
  if    (@nums==5){ ($num,$sprice,$total,$basis,$unreal)=@nums }
  elsif (@nums==4){ ($sprice,$total,$basis,$unreal)=@nums }
  elsif (@nums==3){ ($total,$basis,$unreal)=@nums };
  my(%h)=(desc=>$desc);
  $h{num}   =$num    if defined $num;
  $h{sprice}=$sprice if defined $sprice;
  $h{total} =$total  if defined $total;
  $h{basis} =$basis  if defined $basis;
  $h{unreal}=$unreal if defined $unreal;
  return \%h;
};

sub is_account {
  my($text)=@_;
  my(@tok)=split(/\s+/,$text);
  return 0 unless @tok >= 2;
  return 0 unless $tok[0] =~ /^\d{5,10}$/;
  return !is_num($tok[-1]);
};

sub main {
  open(STDOUT,">&=1") or die "reopen stdout: $!";
  my(%doc);
  for my $file(sort glob("tsv/*.tsv")){
    my($p)=path($file);
    my($key)=($file=~m{(\d\d\d\d-Q\d)})[0];
    push(@{$doc{$key}},TsvFile->new($p));
  };
  my(%result);
  for my $key(sort keys %doc){
    my $d=TsvDoc->new($key,$doc{$key});
    my(@xacts,@ivsts);
    my($section,$account)=('','');
    for my $page(@{$d->pages}){
      my(@words)=vert_sort(grep{defined $_->text}@{$page->word});
      my(@rows);
      while(@words){
        my(@row)=group_find(@words);
        push(@rows,\@row);
        my(%seen)=map{$_=>1}@row;
        @words=grep{!$seen{$_}}@words;
      };
      for my $row(@rows){
        my(@w)=words_merge(@$row);
        my($text)=join(' ',map{$_->text}@w);
        if   ($text=~/^TRANSACTION/){ $section='xact'; next }
        elsif($text=~/^INVESTMENT/) { $section='ivst'; next }
        next unless $section;
        next if $text=~m{^(Date\b|Number\b|Page\b|A CONSOL|COVERING|HOW MY)}i;
        if(is_account($text)){ $account=(split(/\s+/,$text))[0]; next };
        if($section eq 'xact'){
          my($x)=parse_xact(@w);
          if($x){ $x->{account}=$account; push @xacts,$x };
        } elsif($section eq 'ivst'){
          my($i)=parse_ivst(@w);
          if($i){
            $i->{account}=$account;
            push @ivsts,$i;
          } elsif(@ivsts && $text=~/^\w/ && $text!~/^\d/ && $text!~/\d$/ && length($text)<40){
            $ivsts[-1]{cat}=$text;
          };
        };
      };
    };
    $result{$key}={ xact=>\@xacts, ivst=>\@ivsts };
  };
  print JSON::PP->new->pretty->canonical->encode(\%result);
};
main;
