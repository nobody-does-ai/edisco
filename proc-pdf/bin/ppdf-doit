sub err {
  say STDERR "@_";
};
my(%del);
sub mk_pngs {
  my(%seen);
  chdir($Bin);
  chdir("..");
  for my $y(map { 2020+$_ } 4) {
    for my $q(map { "Q$_" } 1) {
      last if -e "trn.png" and -e "inv.png";
      for(glob("src/$y-$q.*pdf")) {
        local($,)=" ";
        say $y, $q, $_;;
        $seen{$_}=1 ;
        my ($if)=path("out")->child($y)->child($q)->child("state.pdf")->touchpath;
        path($_)->copy($if);
        chdir($if->parent);
        if(-e "lores.tsv") {
          open(STDIN,"-|",qw(cat lores.tsv));
        } else {
          system("convert -density 100 state.pdf -append lores.png");
          open(STDIN,"-|",qw(tesseract --user-words),qq{$ENV{PWD}/src/pollock.list},qw(lores.png - tsv));
          open(STDIN,"-|",qw(tee lores.tsv.new));
        };
        $/="\n";
        while(<STDIN>){
          last if m{text$};
        };
        my(@head)=split;
        while(<STDIN>){
          last if m{INVESTMENTS$};
        };
        my(@inv)=split;
        while(<STDIN>){
          last if m{TRANSACTIONS$};
        };
        my(@tra)=split;
        <STDIN>;
        unless(-e "lores.tsv") {
          if(@head and @tra and @inv) {
            path("lores.tsv.new")->move("lores.tsv");
          } else {
            die "failed to make lores.tsv";
          };
        };
        unless(-e "hires.png") {
          system("convert -density $den state.pdf -append hires.png");
        };
        say STDERR "@head";
        while($head[0] ne 'top'){
          shift(@$_) for \( @head, @inv, @tra );
        };
        my($img)=$_[0]=GD::Image->newFromPng("hires.png",1);
#            my($inv)=slice_y($img,1,$t[0],$b[0]);
#            path("inv.png")->spew_raw($inv->png);
#            my($trn)=slice_y($img,0,$t[1],$b[1]);
#            path("trn.png")->spew_raw($trn->png);
      };
    };
  }
#      
#      @_ = map { path($_) } @_;
#      local(@_)=@_;
#      my(@tsv);
#      for my $pdf(@_) {
#        my($tsv)=path(grep { s{(pdf|src)}{tsv}g } $pdf->stringify);
#        local(@_);
#        @_=pdf_to_pgs($pdf);
#        @_=pdf_to_png(@_);
#        @_=png_to_tsv(@_);
#        @_=tsv_to_one($tsv,@_);
#      };
} 
sub main {
  mk_pngs;
  system("ls -l *.png");
  system("xdg-open inv.png");
  system("xdg-open trn.png");
};
