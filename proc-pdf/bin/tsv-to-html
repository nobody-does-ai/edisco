our(@VERSION) = qw( 0 1 0 );
sub hash {
  local(@_)=@_;
  @_=map { [split m{\t}] } @_;
  my(@cols)=map { @$_ } shift;
  for(@_) {
    local(*_)=$_;
    my(%word)=map { $_, shift } @cols;
    $_=\%word;
  };
  \@_;
};
sub find_inv_tra {
  my(%page) = map { path($_)->basename(".tsv"), [ path($_)->lines ] } @_;
  my(@tsv)=sort keys %page;
  chomp(@$_) for values %page;
  my($base)=0;
  my(%mark);
  for(my $i=0;$i<@tsv;$i++) {
    my($tsv)=$tsv[$i];
    my($page);
    for($page{$tsv}) {
      local(*_)=$_;
      $_=hash(@_);
      say $_->{top} for @$_;
      my(@words)=grep { $a->{level}==5 } @$_ ;
      (@words)=TsvWord->from(@words);
      @words = sort { $a->top <=> $b->top } @words;
      for(@words) {
        say $_->top;
      };
      my($last)=0;
      for(@words) {
        say $_->text;
        die pp($_, $last) unless $_->top >= $last;
        $last=$_->top;
      };
      my($page)=shift @words;
    };
  }
  \%page;
#      eex(\%page);
};
our(%page);
sub group_text {
  return join(" - ", map { $_->text } @_);
};
sub find_group {
  local(*_)=shift;
  my(@word)=shift;
  my($top,$bot)=($word[0]->top,$word[0]->bottom);
  ($top,$bot)=(min($top,$bot),max($top,$bot));
  for (my $i=0;$i<@_;$i++) {
    my($word)=$_[$i];
    my($t,$b)=($word->top,$word->bottom);
    next if (($t<$top && $b<$top) or ($t>$bot && $b>$bot));
    push(@word,splice(@_,$i,1,undef));
  };
  for(@word) {
    eex $_->top, $_->bottom, $_->text;
  };
  say STDERR "\n\n";
  @_=grep { defined } @_;
  \@word;
};
sub main {
  my(@tsv)=map { path($_) } glob("tsv/*.tsv");
  my(%page);
  my(@group);
  my(%trig) = map { $_, 1 } qw( TRANSACTIONS INVESTMENTS );
  for(sort @tsv){
    my(@page);
    @_=tsv_parse($_);
    next unless @_;
    @_=TsvWord->from(@_);
    @_=grep { $_->level == 5 } @_;
    while(@_){
      push(@group,find_group(\@_));
    };
  };
  for(@group) {
    say group_text(@$_);
  };
  #  path("pages.json")->spew($coder->encode(\%page));
