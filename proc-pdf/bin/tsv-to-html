#!/opt/bin/vi-perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use lib "lib";
use common::sense;
use TsvSet;
use autodie;
use Nobody::Util;
use TsvUtil;
use Carp qw( croak confess carp cluck );
use Carp::Always;
use Tsv;
use vars qw($coder);
*coder=\$Tsv::coder;
use feature qw(signatures);
our(@VERSION) = qw( 0 1 0 );
sub find_inv_tra {
  my(%page) = map { path($_)->basename(".tsv"), [ path($_)->lines ] } @_;
  my(@tsv)=sort keys %page;
  chomp(@$_) for values %page;
  my($base)=0;
  my(%mark);
  for(my $i=0;$i<@tsv;$i++) {
    my($tsv)=$tsv[$i];
    my($page);
    for($page{$tsv}) {
      local(*_)=$_;
      my($i,$t);
      $_=hash(@_);
      my(@words)=grep { $a->{level}==5 } @$_ ;
      (@words)=TsvWord->from(@words);
      @words = sort { $a->top <=> $b->top } @words;
      for(@words) {
        say $_->top;
      };
      my($last)=0;
      for(@words) {
        say $_->text;
        die pp($_, $last) unless $_->top >= $last;
        $last=$_->top;
      };
      my($page)=shift @words;
    };
  }
  \%page;
};
our(%page);
sub group_text {
  return join(" ", map { $_->text } @_);
};
my(%trig) = map { $_, 1 } qw( TRANSACTIONS INVESTMENTS );
sub find_group {
  local(@_)=@_;
  local(*_)=shift;
  my(@word)=shift;
  return \@word if $trig{$word[0]->text};
  my($top,$bot)=($word[0]->top,$word[0]->bottom);
  ($top,$bot)=(min($top,$bot),max($top,$bot));
  for (my $i=0;$i<@_;$i++) {
    my($word)=$_[$i];
    my($a)=sum($word->top,$word->bottom)/2;
    next unless (($a>$top && $a<$bot));
    push(@word,splice(@_,$i,1,undef));
  };
  @_=grep { defined } @_;
  \@word;
};
sub main {
  local(@_)=@_;
  my(@tsv)=map { path($_) } sort glob("tsv/202?-Q?.tsv");
  for(sort @tsv){
    my(@group);
    my($of)=$_;
    for($of){
      s{tsv}{html}g;
      $_=path($_);
    };
    eex({of=>$of});
    @_=tsv_parse_file($_);
    shift;
    pop(@_) for 1 .. 4;
    next unless @_;
    @_=TsvWord->from(@_);
    next unless grep { $trig{$_->text} } @_;
    @_=grep { $_->level == 5 } @_;
    for(@_) {
      last if $trig{$_->text};
      $_=undef 
    };
    @_=grep { defined } @_;
    say scalar(@_);
    while(@_){
      push(@group,find_group(\@_));
    };
    for(@group) {
      push(@$_,group_text(@$_));
    };
  };
}
main(@ARGV);
