#!/opt/bin/vi-perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use lib "lib";
use common::sense;
use TsvSet;
use autodie;
use Nobody::Util;
use TsvUtil;
use Carp qw( croak confess carp cluck );
use Carp::Always;
use Tsv;
use vars qw($coder);
*coder=\$Tsv::coder;
use feature qw(signatures);
our(@VERSION) = qw( 0 1 0 );
our(%page);
my(%trig) = map { $_, 1 } qw( TRANSACTIONS INVESTMENTS Page POLLOCK );
sub space_text {
  my(@res)=shift;
  for(@_){
    my($last)=$res[$#res];
#        if($_->left < $last->right){
#          eex($last,$_);
#        };
    my($space)= $_->left-$last->right;
    if($space>10) {
      $space=join($_->left,"(",")");
      push(@res,$space);
    };
    push(@res,$_);
  };
  for(@res){
    $_=$_->text if ref;
  };
  local($")=" ";
  "@res";
};
sub main {
  local(@_)=@_;
  my(@tsv)=map { path($_) } sort glob("tsv/2024-Q1.tsv");
  my @g;
  my $g=[];
  push(@g,$g);
  for(sort @tsv){
    my($state)="";
    my(@group);
    my($of)=$_;
    for($of){
      s{tsv}{html}g;
      $_=path($_);
    };
    @_=tsv_parse_file($_);
    eex shift;
    next unless @_;
    @_=TsvWord->from(@_);
    @_=sort { $a->cy <=> $b->cy } @_;
    my($i)=0;
    @_=grep { $_->level == 5 } @_;
    while(@_){
      ++$i;
      if(exists $trig{$_[0]->text}){
        $state=$_[0]->text;
        push(@g,$g=[]);
        if($_[0]->text eq "POLLOCK"){
          push(@$g,[shift(@_)]);
          push(@g,$g=[]);
        };
      };
      my(@tmp)=@{find_group(\@_)};
      @tmp = sort { $a->cx <=> $b->cx } @tmp;
      @tmp = grep { defined } @tmp;
      push(@$g,\@tmp);
    };
  };
  for(@g) {
    for(@{$_}){
      if(grep { $trig{$_->text} } @$_) {
        say group_text(@$_);
      };
    };
  };
}
main(@ARGV);
