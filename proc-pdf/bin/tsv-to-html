sub space_text {
  my(@res)=shift;
  for(@_){
    my($last)=$res[$#res];
#        if($_->left < $last->right){
#          eex($last,$_);
#        };
    my($space)= $_->left-$last->right;
    if($space>10) {
      $space=join($_->left,"(",")");
      push(@res,$space);
    };
    push(@res,$_);
  };
  for(@res){
    $_=$_->text if ref;
  };
  local($")=" ";
  "@res";
};
