#!/opt/bin/vi-perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use autodie;
use common::sense;
use Carp qw( croak confess carp cluck );
use Carp::Always;
use Nobody::Util;
use Tsv; use TsvUtil; use TsvWord;
use TsvLine;
our(@VERSION) = qw( 0 1 0 );
our(%data);
(*data)=require(path("dat/all.dat.pl")->absolute->stringify);
sub row {
  local(@_)=@_;
  my($extra)=(@_>1?"":'colspan="4"');
  $_="  $_" for @_;
  @_=map { ("<td $extra>", $_, "</td>") } @_;
  $_="  $_" for @_;
  unshift(@_,"<tr>");
  push(@_,"</tr>");
  @_;
};
sub formdate {
  local(*_)=$_[0];
  my($m,$d,$y)=m{(\d\d)/(\d\d)/(\d\d\d\d)};
  return undef unless defined $y;
  $_=join("-",$y,$m,$d); 
  return 1;
};
sub trn {
  my($trn)=shift;
  local(*_)=$trn->word;
  local($_)=$_[0];
  @_=map { $_->text } @_;
  for($_[0]) {
    local($")=" ";
    if($_ eq "Date"){
      return row("Hdr", "header", "hdr");
    } elsif(@_>2 and formdate(\$_)) {
      my($date)=($_,shift);
      my($amnt)=pop;
      my($text)="@_";
      return row( $date, $text, $amnt );
    } else {
      return row( "@_" );
    };
    $_="  $_" for @_;
  };
};
sub main {
  our(@trn,@inv);
  for my $period ( keys %data ) {
    local(*data)=$data{$period};
    (*trn,*inv) =map { $data{$_} } qw( trn inv ); 
    say scalar(@trn), " transactions";
    say scalar(@inv), " investments";
    say "<table>";
    say trn($_) for @trn;
    say "</table>";
  }
};
main(@ARGV);
