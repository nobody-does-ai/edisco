#!/usr/bin/perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use common::sense;
use autodie;
use Nobody::Util;
use Nobody::PP;
use Env qw( @PATH @PERL5LIB $HOME );
our(@VERSION) = qw( 0 1 0 );
use IO::Pty;
my($pty)=IO::Pty->new;
if(fork){
  my($slave)=$pty->slave;
  open(STDIN,"<",$slave);
  open(STDOUT,">",$slave);
  $pty->make_slave_controlling_terminal();


