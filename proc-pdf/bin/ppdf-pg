#!/usr/bin/perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use common::sense;
use autodie;
use Nobody::Util;
use Nobody::PP;
our(@VERSION) = qw( 0 1 0 );
use Pg;

my($conn)=Pg::connectdb("dbname=nn");
my($res)=$conn->exec("select * from tsv");
my(@row);
while(@row=$res->fetchrow){
  print join(" ", @row);
};
