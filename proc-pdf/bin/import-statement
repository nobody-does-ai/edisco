use AnyEvent;
use AE;
sub handle_png;
sub make_png {
  my(%pdf)=%{+shift};

  $pdf{base}=$pdf{pdff}->basename('.pdf');
  print STDERR "==> Processing $pdf{pdff}\n";
  $pdf{pcnt}=get_page_count($pdf{pdff});
  unless (defined $pdf{pcnt} && $pdf{pcnt} > 0) {
    die "Could not determine page count for '$pdf{pdff}', skipping.\n";
    return;
  }

  say STDERR "    Pages: $pdf{pcnt}";

  # 1. Render selected pages to PNG (document-at-a-time)
  $pdf{pfix}=$img_dir->child($pdf{base})->stringify;
  for(@{$pdf{list} = [glob("$pdf{pfix}*.png")]}){
    s{[.]png$}{};
  };
  my @cmd = (
    'pdftoppm',
    '-png',
    '-r', 300,
    '-f', 1,
    '-l', $pdf{pcnt},
    $pdf{pdff},
    $pdf{pfix},
  );
  print STDERR "    Running: @cmd\n";
  my($pid)=fork;
  unless($pid) {
    exec(@cmd);
    die "exec @_:$!";
  };
  $DB::single=1;
  $pdf{ecb}=AE::child $pid, sub { eex(\@_); handle_png(\%pdf) };
};
sub handle_png {
  my(%pdf)=%{+shift};
  # 2. Build page_number -> PNG path map, handling zero-padding
  eex( "pdftoppm done" );
  my %png_for_page;
  for my $png ($->children(qr/^\Q$pdf{base}\E-\d+\.png$/)) {
    my $name = $png->basename;
    next unless $name =~ /^\Q$pdf{base}\E-(\d+)\.png$/;
    my $pageno = int($1);  # '01' -> 1, '10' -> 10, etc.
    $png_for_page{$pageno} = $png;
  }

  # 3. For each expected page, run tesseract -> TSV
  for my $page (1 .. $pdf{last}) {
    my $png = $png_for_page{$page};

    unless ($png && $png->is_file) {
      warn "    Missing PNG for $pdf{pdff} page $page (expected $pdf{base}-<n>.png)\n";
      next;
    }

    my $tsv_prefix = $tsv_dir->child("$pdf{base}-$page")->stringify;
    my $tsv_file   = $tsv_prefix . '.tsv';

    # Skip if TSV already exists; comment this out if you want to re-run
    if (-f $tsv_file) {
      print STDERR "    [exists] $tsv_file\n";
      next;
    }

    my @tcmd = (
      'tesseract',
      $png->stringify,
      $tsv_prefix,
      '-l', 'eng',
      'tsv',
    );
    print STDERR "    tesseract page $page -> $tsv_file\n";
    my $pid=fork;
    if(!$pid) {
      run_cmd_or_die_on_sigint(@tcmd);
      exit($?);
    };
    AE::child $pid, sub { die pp(\@_) };
  }
}

sub get_page_count {
  my ($pdf) = @_;

  my @cmd = ('pdfinfo', $pdf);
  my $info = qx/@cmd 2>&1/;
  if ($? != 0) {
    warn "pdfinfo failed on '$pdf': $info";
    return undef;
  }

  my ($pages_line) = $info =~ /^Pages:\s+(\d+)/mi;
  return $pages_line ? int($pages_line) : undef;
}

# Pipeline driver entry point
main(@ARGV);
