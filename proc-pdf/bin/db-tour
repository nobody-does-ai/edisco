#!/usr/bin/perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
our(@VERSION) = qw( 0 1 0 );
use common::sense;
use autodie;
use Nobody::Util;
use TsvDB;
use feature qw(signatures);
our(%sql);

sub disp_query($sql) {
  my($data)=hash_fetch($sql);
  eex($data);
};
sub main {
  $sql{list_tabs}="select distinct table_schema, table_name from information_schema.tables order by table_schema, table_name";
  disp_query($sql{list_tabs});
};
main;
