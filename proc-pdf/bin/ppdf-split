#!/usr/bin/perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
if 0;
$|++;
use common::sense;
use autodie;
use Nobody::Util;
use Getopt::WonderBra;
use TsvUtil;
our(@VERSION) = qw( 0 1 0 );

# ppdf-split: Split PDF into individual pages
# Part of proc-pdf toolkit

sub get_page_count;
sub help {
  die("Use The Source, Luke!");
}
sub main (@) {
  local(@_)=@_;
  @_=glob("src/*.pdf") unless @_;

  my(%pages);
  for(@_){
    my($if)=$_;
    $pages{$_}= get_page_count($_);
    die "Error: Could not determine page count for $_\n" unless
      defined $pages{$_};
  };
  for(sort keys %pages) {
    my ($fmt)="%-20s";
    printf STDERR "$fmt %s ...\n", $_, $pages{$_};
  }

  my($fmt)="pdf/%s-%03d.pdf";
  my ($op)=0;
  my $pp=0;
  for(sort keys %pages) {
    my ($if)=path($_);
    my ($pc)=$pages{$_};
    my ($pg);
    for ($pg=1;$pg<$pc;$pg++ ) {
      my ($ib)=$if->basename('.pdf');;
      my ($of)=path(sprintf($fmt,$ib,$pp++));
      $of->parent->mkdir;
      my (@cmd)=(
        qw(qpdf),
        $if,
        qw( --pages .),
        $pg,
        '--',
        $of);
      system(@cmd);
    };
    say STDERR "extracted $pg pages from $if";
  }
}
main(@ARGV);
