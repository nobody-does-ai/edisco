#!/usr/bin/perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use common::sense;
use autodie;
use Nobody::Util;
use Nobody::PP;
our(@VERSION) = qw( 0 1 0 );
use TsvUtil qw(group_find vert_sort words_merge);
use TsvFile;
use TsvDoc;

sub main;
main(@ARGV);
exit(0);
sub main {
  my(%doc);
  for my $file(sort glob("tsv/*.tsv")){
    my($p)=path($file);
    my($key)=($file=~m{(\d\d\d\d-Q\d)})[0];
    push(@{$doc{$key}},TsvFile->new($p));
  };
  for my $key(sort keys %doc){
    my($d)=TsvDoc->new($key,$doc{$key});
    say $d->key;
    for my $page(@{$d->pages}){
      my(@words)=vert_sort(grep{defined $_->text}@{$page->word});
      my(@rows);
      while(@words){
        my(@row)=group_find(@words);
        push(@rows,\@row);
        my(%seen)=map{$_=>1}@row;
        @words=grep{!$seen{$_}}@words;
      };

      say sprintf("  %s  %d rows",$page->path,scalar(@rows));
      for my $row(@rows){
        my($text)=join(" ",map{$_->text}words_merge(@$row));
        say $page, " ", sprintf("    %s",$text);
      };
    };
  };
};
