#!/usr/bin/perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use common::sense;
use autodie;
use Nobody::Util;
use Nobody::PP;
our(@VERSION) = qw( 0 1 0 );

my(@tsv)=map { path($_) } glob("tsv/*.tsv");
for(@tsv) {
  $_=undef if grep { m{INVESTMENT|TRANSACTION} } $_->lines;
};

$_->remove for grep { defined } @tsv;
