use Carp::Always;
use vars (@var);
use Carp qw( cluck confess croak carp );
use List::Util qw();
use List::Util @List::Util::EXPORT_OK;
use Nobody::PP;
use TsvFile;
use TsvGroup;
use TsvRect;
use TsvWord;
use TsvUtil qw( pdf_to_png png_to_tsv pdf_to_pgs pdf_page_count );
use autodie;
use common::sense;
use feature qw(state);
our(@VERSION) = qw( 0 1 0 );
our(%file);
sub main;
main(@ARGV);
exit(0);
sub main {
  @_=glob("src/*.pdf") unless @_;
  my(@file) = map{path($_)} @_;
  @file=map { path($_) } pdf_to_pgs(@file);
  @file=pdf_to_png(@file);
  @file=png_to_tsv(@file);
  for my $file (@file) {
    say $file;
  }
}
