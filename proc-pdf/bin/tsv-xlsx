#!/usr/bin/perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use lib "lib";
use common::sense;
use autodie;
use Nobody::Util qw(path);
use JSON::PP;
use Excel::Writer::XLSX;

my($out_dir)=path("xlsx")->mkdir;

for my $file (sort glob("json/*.json")) {
  my($key)=path($file)->basename(".json");
  my($data)=JSON::PP->new->decode(path($file)->slurp);
  my(@xacts)=@{$data->{xact}//[]};
  my(@ivsts)=@{$data->{ivst}//[]};
  next unless @xacts || @ivsts;

  my($out)=$out_dir->child("$key.xlsx");
  my $wb=Excel::Writer::XLSX->new("$out");
  my $hdr=$wb->add_format(bold=>1, bottom=>1);
  my $num=$wb->add_format(num_format=>'#,##0.00');

  ivst_sheet($wb,$hdr,$num,@ivsts) if @ivsts;
  xact_sheet($wb,$hdr,$num,@xacts) if @xacts;

  $wb->close;
  say $out;
}

sub xact_sheet {
  my($wb,$hdr,$num,@rows)=@_;
  my $ws=$wb->add_worksheet('Transactions');
  my @cols=qw(Account Date Description Amount);
  $ws->write_row(0,0,\@cols,$hdr);
  $ws->set_column(0,0,12);
  $ws->set_column(1,1,12);
  $ws->set_column(2,2,40);
  $ws->set_column(3,3,14);
  my $r=1;
  for my $x (@rows) {
    $ws->write_string($r,0,$x->{account}//'');
    $ws->write_string($r,1,$x->{date}//'');
    $ws->write_string($r,2,$x->{desc}//'');
    if(defined $x->{amount}){
      $ws->write_number($r,3,$x->{amount},$num);
    }
    $r++;
  }
}

sub ivst_sheet {
  my($wb,$hdr,$num,@rows)=@_;
  my $ws=$wb->add_worksheet('Investments');
  my @cols=('Account','Description','Shares','Price','Total','Basis','Unrealized');
  $ws->write_row(0,0,\@cols,$hdr);
  $ws->set_column(0,0,12);
  $ws->set_column(1,1,30);
  $ws->set_column(2,6,14);
  my $r=1;
  for my $i (@rows) {
    $ws->write_string($r,0,$i->{account}//'');
    $ws->write_string($r,1,$i->{desc}//'');
    for my $c ([2,'num'],[3,'sprice'],[4,'total'],[5,'basis'],[6,'unreal']) {
      if(defined $i->{$c->[1]}){
        $ws->write_number($r,$c->[0],$i->{$c->[1]},$num);
      }
    }
    $r++;
  }
}
