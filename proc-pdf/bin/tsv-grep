#!/opt/bin/vi-perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use lib 'lib';
use common::sense;
use GDUtil;
use autodie;
use Nobody::Util;
use GD::Image;
use Carp qw( croak confess carp cluck );
use Carp::Always;
use Tsv;
use TsvDB;
use Term::Table;
our(@VERSION) = qw( 0 1 0 );
{
  package snitch;
  *eex=*main::eex;
  sub TIESCALAR {
    my($s);
    return bless(\$s);
  };
  sub TIEARRAY {
    my(@a);
    return bless(\@a);
  }
  sub TIEHASH {
    my(%h);
    return bless(\%h);
  };
  sub STORE {
  };
  sub FETCH {
  };
  sub DESTROY {
  };
  our($AUTOLOAD);
  sub AUTOLOAD {
    local(@_)=@_;
    eex($AUTOLOAD,\@_);
  };
};
sub split_ln {
  map { [ split m{[\r\t]} ] } @_;
};
my(@trash);
sub load_words {
  local(@_);
  for(sort glob("tsv/202?-Q?-*.tsv")){
    push(@_,[TsvWord->parse_file(path($_))]);
  };
  return \@_;
};
sub main {
  path("output")->touchpath;
  system("tail -F output &");
  open(STDOUT,">output");
  @_=load_words;
  my($reftype,$count)=("",0);
  while(@_){
    local($_)=shift;
    eex($_);
    if($reftype ne ref){
      say STDERR "\b\b\b\bx$count" if($reftype);
      $reftype=ref;
      $count=1;
      print STDERR "$reftype ...";
      STDERR->autoflush(1);
    } else {
      ++$count;
    };
    if(ref eq 'HASH'){
      push(@_,values %$_);
    } elsif(ref eq 'ARRAY'){
      push(@_,@$_);
    } elsif(ref eq 'REF') {
      push(@_,$$);
    } elsif(ref eq 'SCALAR'){
      push(@_,$$);
    };
  };
};
END { system qw{fuser -k output}; };
main
__DATA__
  exit(0);
#        my(@word)=TsvWord->load_file($tsv);
#        @word=grep { $_->level == 5 } @word;
#        @word = sort {
#          $a->top <=> $b->top
#            or
