#!/opt/bin/vi-perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use lib "lib";
use common::sense;
use GDUtil;
use TsvSet;
use autodie;
use Nobody::Util;
use GD::Image;
use Carp qw( croak confess carp cluck );
use Carp::Always;
use Tsv;
use vars qw($coder);
*coder=\$Tsv::coder;
use feature qw(signatures);
our(@VERSION) = qw( 0 1 0 );
sub main {
  my(%tgt)=map { $_, 1 } qw(434097 Rich Richard John);
  my(@tsv)=glob("tsv/*.tsv");
  my(@im,$im);
  my($red);
  for my $tsv(map { path($_) } @tsv) {
    my($png)=path(sprintf("png/%s.png",$tsv->basename(".tsv")));
    die "no png" unless $png->exists;
    my(@word)=$tsv->lines;
    chomp(@word);
    @word = map { [split m{\t}] } @word;
    my(@col)=map { @$_ } shift(@word);
    for(@word){
      my(%word);
      @word{@col}=@$_;
      $_=\%word;
    };
    @word=TsvWord->from(@word);
    @word = grep { defined($_->text) } @word;
    @word = sort {
      $a->top <=> $b->top
        or
      $a->left <=> $b->left
        or
      refaddr($a) <=> refaddr($b)
    } @word;
    for(my $i=1;$i<@word;$i++){
      my($word)=$word[$i];
      if($tgt{$word->text}){
        my($t,$b)=($i,$i);
        while($word[--$t]->bottom > $word[$i]->top) {
          #eex("t", $t, $word[$t]->rect, $word[$t]->text, $word[$i]->rect);
          last unless $t;
        };
        ++$t;
        while($word[++$b]->top < $word[$i]->bottom) {
          #eex("b", $t, $word[$b]->rect, $word[$b]->text, $word[$i]->rect);
          last if $b>=@word;
        };
        --$b;
        for(my $j=$t;$j<=$b;$j++){
          eex (($word[$j]->left)-($word[$j-1]->right)) if $j>$t;
          eex $word[$j];
        };
        if(grep { $_->text eq "Lisa" } @word[$t .. $b]) {
          next;
        };
        unless(defined $im){
          $im=GD::Image->newFromPng("$png",1);
        };
        my($y1)=$word->top-int($word->height);
        my($y2)=$y1+$word->height*3;
        my($sl)=slice_y($im,$y1,$y2);
        push(@im,$sl);
        path("tmp")->child($png->basename)->spew_raw($im->png);
      };
    }
    undef($im);
  }
  eex(\@im);
  $im=stack_slices(@im);
  for my $im ($im, @im) {
    eex( [ map { $_, $im->$_() } qw( height width ) ] );
  };
  path("image.png")->spew($im->png);
}
main(@ARGV);
