#!/opt/bin/vi-perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use common::sense;
use GDUtil;
use autodie;
use Nobody::Util;
use GD::Image;
use Carp qw( croak confess carp cluck );
use Carp::Always;
use Tsv;
use TsvWord;
use TsvLine;
use vars qw($coder);
*coder=\$Tsv::coder;
use feature qw(signatures);
our(@VERSION) = qw( 0 1 0 );
sub main {
  my($txt)=chr(0xc2).chr(0xa2);
  my($tgt)=qr{$txt};
  my(@tsv)=glob("tsv/*.tsv");
  my(%tgt);
  for my $tsv(map { path($_) } @tsv) {
    my($png)=path(sprintf("png/%s.png",$tsv->basename(".tsv")));
    next unless $png->exists;
    my(@word)=TsvWord->load_file($tsv);
    @word=grep { $_->level == 5 } @word;
    @word = sort {
      $a->top <=> $b->top
        or
      $a->left <=> $b->left
    } @word;
    @word=TsvLine->from(@word);
    @word=grep { defined } @word;
    @word=grep { $_->text =~ m{$tgt} } @word;
    for(@word) {
      $tgt{$png}//=[undef];
      my($txt)=$_->text;
      push(@{$tgt{$png}}, { top=>($_->top-10), bot=>($_->bottom-5), line=>$_});
    };
  }
  our(%slc,@slc);
  for my $png(keys %tgt) {
    local(*_)=$tgt{$png};
    my($img);

    $img=$_[0]=GD::Image->newFromPng("$png",1);
    for(1 .. $#_) {
      local(*slc)=$_[$_]; 
      next if $slc{num}[0]==5;
      push(@slc,$slc{slc}=slice_y($img,$slc{num}[0]==4?1:0,$slc{top},$slc{bot}));
    };  
  };
  ddx(\%tgt);
  my($img)=stack_slices(@slc);
  path("image.png")->spew_raw($img->png);
};
main(@ARGV);
