#!/opt/bin/vi-perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use common::sense;
use GDUtil;
use autodie;
use Nobody::Util;
use GD::Image;
use Carp qw( croak confess carp cluck );
use Carp::Always;
use Tsv;
use TsvWord;
use TsvLine;
use vars qw($coder);
*coder=\$Tsv::coder;
use feature qw(signatures);
our(@VERSION) = qw( 0 1 0 );
sub main {
  my($tgt)=qr{macro.*strategies.*fund}i;
  my(@tsv)=@_;
  (@tsv)=glob("tsv/*.tsv") unless @tsv;
  my(%tgt);
  for my $tsv(map { path($_) } @tsv) {
    my($png)=path(sprintf("png/%s.png",$tsv->basename(".tsv")));
    next unless $png->exists;
    my(@word)=TsvWord->load_file($tsv);
    @word=grep { $_->level == 5 } @word;
    @word = sort {
      $a->top <=> $b->top
        or
      $a->left <=> $b->left
        or
      refaddr($a) <=> refaddr($b)
    } @word;
    my($inv)=grep { $word[$_]->text eq 'INVESTMENTS' } 0 .. $#word;
    next unless defined $inv;
    my($trn)=grep {  $word[$_]->text eq 'TRANSACTIONS' } 0 .. $#word;
    $trn//=$#word;
    @word=@word[$inv..$trn];
    @word=TsvLine->from(@word);
    @word=grep { defined } @word;
    @word=grep { $_->text =~ m{$tgt} } @word;
    for(@word) {
      $tgt{$png}//=[undef];
      my($txt)=$_->text;
      my(@num);
      for($txt) {
        s{ETF(.*)}{ETF}i;
        @num=map { split } $1;
        unshift(@num,scalar(@num));
      };
      push(@{$tgt{$png}}, { top=>($_->top-10), bot=>($_->bottom-5), txt=>$txt, num=>\@num });
    };
  }
  our(%slc,@slc);
  for my $png(keys %tgt) {
    local(*_)=$tgt{$png};
    my($img)=$_[0]=GD::Image->newFromPng("$png",1);
    for(1 .. $#_) {
      local(*slc)=$_[$_]; 
      next if $slc{num}[0]==5;
      push(@slc,$slc{slc}=slice_y($img,$slc{num}[0]==4?1:0,$slc{top},$slc{bot}));
    };  
  };
  ddx(\%tgt);
  my($img)=stack_slices(@slc);
  path("image.png")->spew_raw($img->png);
};
main(@ARGV);
