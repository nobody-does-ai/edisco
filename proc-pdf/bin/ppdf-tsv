#!/usr/bin/perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use Nobody::Util;
BEGIN {
  use FindBin qw($Script $Bin);
  use lib "$Bin/../lib";
};
use Carp::Always;
use vars (@var);
use Carp qw( cluck confess croak carp );
use List::Util qw();
use List::Util @List::Util::EXPORT_OK;
use Nobody::PP;
use TsvFile;
use TsvRect;
use TsvWord;
use TsvUtil;
use autodie;
use common::sense;
use feature qw(state);
our(@VERSION) = qw( 0 1 0 );
our(%file);
use vars qw( $coder );
*coder=\$Tsv::coder;
sub main;
@ARGV=glob("src/*.pdf") unless @ARGV;
main(@ARGV);
exit(0);
sub err {
  say STDERR "@_";
};
sub main {
  @_ = map { path($_) } @_;
  local(@_)=@_;
  for(@_) {
    say;
    local(@_)=pdf_to_pgs($_);
    @_=pdf_to_png(@_);
    @_=png_to_tsv(@_);
  };
}
