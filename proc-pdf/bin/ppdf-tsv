#!/usr/bin/perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use Nobody::Util;
BEGIN {
  use FindBin qw($Script $Bin);
  use lib "$Bin/../lib";
};
use TieHandleDebug;
tie *STDOUT , 'TieHandleDebug';
tie *STDERR , 'TieHandleDebug';
use Carp::Always;
use vars (@var);
use Carp qw( cluck confess croak carp );
use List::Util qw();
use List::Util @List::Util::EXPORT_OK;
use Nobody::PP;
use TsvRect;
use TsvWord;
use TsvUtil;
use autodie;
use common::sense;
use feature qw(state);
our(@VERSION) = qw( 0 1 0 );
our(%file);
# this gathers all the modules used and puts them into
# the lib directory.  not normally needed, should be
# commented out.
#require "$ENV{HOME}/stow/ex-code/gather.pl";
use vars qw( $coder );
*coder=\$Tsv::coder;
sub main;
#    @ARGV=glob("src/2024-Q4.pdf") unless @ARGV;
@ARGV=glob("src/202?-Q?.pdf") unless @ARGV;
main(@ARGV);
exit(0);
sub err {
  say STDERR "@_";
};
my(%del);
sub main {
  @_ = map { path($_) } @_;
  local(@_)=@_;
  my(@tsv);
  for my $pdf(@_) {
    my($tsv)=path(grep { s{(pdf|src)}{tsv}g } $pdf->stringify);
    local(@_);
    @_=pdf_to_pgs($pdf);
    @_=pdf_to_png(@_);
    @_=png_to_tsv(@_);
    eex($tsv);
    @_=tsv_to_one($tsv,@_);
  };
} 
