#!/usr/bin/perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use Nobody::Util;
use Carp::Always;
use vars (@var);
use Carp qw( cluck confess croak carp );
use List::Util qw();
use List::Util @List::Util::EXPORT_OK;
use Nobody::PP;
use TsvRect;
use TsvWord;
use TsvUtil qw( pdf_to_pgs pdf_to_png png_to_tsv tsv_to_one );
use autodie;
use common::sense;
use feature qw(state);
our(@VERSION) = qw( 0 1 0 );
our(%file);
# this gathers all the modules used and puts them into
# the lib directory.  not normally needed, should be
# commented out.
#require "$ENV{HOME}/stow/ex-code/gather.pl";
sub main;
#    @ARGV=glob("src/2024-Q4.pdf") unless @ARGV;
@ARGV=glob("src/202?-Q?.pdf") unless @ARGV;
main(@ARGV);
exit(0);
sub err {
  say STDERR "@_";
};
my(%del);
sub main {
  @_ = map { path($_) } @_;
  local(@_)=@_;
  my(@tsv);
  for my $pdf(@_) {
    my($tsv)=path(grep { s{(pdf|src)}{tsv}g } $pdf->stringify);
    my($log)=path(grep { s{(pdf|src)}{log}g } $pdf->stringify);
    if(my $pid=fork) {
      say STDERR "$$:$pid started:$tsv";
    } else {
      open(STDOUT,">",$log->touchpath->stringify);
      open(STDERR,">&".fileno(STDOUT));
      local(@_);
      @_=pdf_to_pgs($pdf);
      @_=pdf_to_png(@_);
      @_=png_to_tsv(@_);
    }
    exit(0);
  };
  child_wait;
} 
