#!/usr/bin/perl
use lib "lib";
use common::sense;
use autodie;
use DBI;
use Time::HiRes qw(sleep );
use DBD::Pg qw(:pg_types); # Required for PGRES constants if needed
use Nobody::Util;
use Nobody::PP;
use TsvDB;
use GD::Image;
use GD;
use GDUtil;
use TsvLine;
use TsvUtil qw(group_find);

$|++;

our(@VERSION) = qw( 0 1 0 );

use Path::Tiny;
our(%marker);
sub show {
  return;
  my($pg,$ln)=(shift,shift);
  for my $word(@_) {
    eex( { a=>$pg, b=>$ln, y=>{ map { $_, $word->$_() } qw( y1 y2 dy ) } } );
    eex( $word->text() );
  };
};
sub count {
  our(%cnt);
  for(@_) {
    $cnt{+refaddr($_)}++;
  };
  eex(%cnt);
};
sub hgroup_find {
  local(@_)=@_;
  local(*_)=shift;
  return unless @_;
  my($i)=0;
  my(@word)=shift;
  my($right)=$word[0]->x2;
  while(@_ and $_[0]->cx<$right) {
    my($word)=shift;
    push(@word,$word);
    $right=$word->x2 if $right<$word->x2;
  }
  sort { $a->x1 <=> $b->x1 } @word;
};
sub png {
  return path("png")->child($_[0]->basename(".tsv").".png");
};
sub img {
  return undef;# GD::Image->newFromPng("$_[0]");
};
my(%trash);
my(%trig);
INIT {
  %trig=(
    qw(
    TRANSACTIONS 2
    INVESTMENTS 2
    KEY 1
    INSURED 1
    Page 1
    Program 1
    )
  );
  my($txt)=chr(0xc2).chr(0xa2);
  for(qw( SY . I IB [| Il ll Re I lo] e eo ] [ ifaveclized - ), $txt) {
    $trash{$_}=1;
  };
  for(    qw{ Investment Domestic Cash of SEI }  ) {
    $trash{$_}=0;
  };
  $trash{Yotal}=\"Total";
  $trash{"(continue)"}=\"[CONTINUE]";
  $trash{"(continuep)"}=\"[CONTINUE]";
  $trash{"(conTinuep)"}=\"[CONTINUE]";
  $trash{"(conTinue)"}=\"[CONTINUE]";
  $trash{"account:"}=\"account:";
  $trash{"Numberios"}=\"Numbers";
  $trash{"Accounts\xE2\x80\x99"}=\"Accounts";
  $trash{"Rem"}=1;
  $trash{"sanuary"}=\"January";
  $trash{ACCT}=\"ACCT";
};
sub no_trash {
  my(@word)=grep { $_->{level} == 5 } @_;
  for(@word) {
    our($text,$conf);
    local(*text)=\$_->{text};
    local(*conf)=\$_->{conf};
    if($conf<70) {
      my($trash)=$trash{$text};
      if(defined($trash)) {
        if($trash==0){ 
          $conf=90;
          $text=$conf=$_=undef;
        } elsif ( ref($trash) eq "SCALAR" ) {
          $text=${$trash};
          $conf=90;
        } else {
          $text=$conf=$_=undef;
        };
      } elsif($text =~ m{^account.s}){
        $text="account(s)";
        $conf=90;
      } elsif($text eq "&") {
        $text="and";
        $conf=90;
        $conf=90;
      } elsif($text =~ m{[0-9]} and $text =~ m{^[0-9\$.,A-]+$}) {
        $conf=90;
        $text =~ s{A}{4}g;
      }
      next if($conf>70);
      next unless defined and defined $text;
#          eex($conf, $text, $trash{$text});
      if($conf<20 and $conf>0){
#            eex( { text=>$text, conf=>$conf } );
        $_=undef;
      };
      if($trash{$text}){
        push(@{$trash{$text}},$_);
        $_->{reject}=1;
        $_=undef;
      };
    }    
  };
  grep { !$_->{reject} } grep { defined } @word;
}
sub filter {
  my(@word)=splice(@_);
  my($page);
  @word = sort { $a->page <=> $b->page or $a->y1 <=> $b->y1 or $a->x1 <=> $b->x2 } @word;
  return @word unless @word;
  while(@word) {
    my($group)=[shift @word];
    push(@_,$group);
    while(@word and !$trig{$word[0]->text}){
      push(@$group,shift(@word));
    }
    if(@word and $trig{$word[0]->text}==2){
      push(@_,$group=[]);      
    } else {
      splice(@word);
    };
  };
  return @_;
};
sub main
{
  my(@l);
  local($SIG{__DIE__})=sub { $DB::single=1; die @_; };
  local($SIG{__WARN__})=sub { $DB::single=1; warn @_; };
  eval {
    dbh->do("delete from tsv");
  };
  my(%page)=map{$_,{path=>path($_)}}sort glob("tsv/202?-Q?-???.tsv");
  for( values %page ) {
    $_=[map { 0+$_ || $_ } split(m{[/.-]Q?}, path($_->{path})->basename(".tsv")),$_->{path}];
  }
  my(@all);
  for my $pg(sort keys %page) {
    my($prec)=$page{$pg};
    my($y,$q,undef,$page)=@{$prec};
    my(@word)=TsvWord->load_file($page);
    @word = grep { $_->level == 5 } @word;
    @word=no_trash(@word);
    while(@word and $trig{$word[0]->text}!=2){
      shift(@word);
    };
    next unless @word;
    for(@word) {
#          for(@$_) {
        my($rect)=$_->{rect};
        if($rect->{y1}%2){ $rect->{y1}--; $rect->{y2}++; };
        if($rect->{x1}%2){ $rect->{x1}--; $rect->{x2}++; };
        $rect->{y2}=$rect->{y1}+13;
        $_->{y}=$y;
        $_->{q}=$q;
        $_->{reject}//=0;
#          };
    };
    push(@all,@word);
  };
  tsv_insert(@all);
  dbh->disconnect;
};
main;
END {
  my($log);
  $log=path("trash.log");
  $log->spew(pp(\%trash));
};
