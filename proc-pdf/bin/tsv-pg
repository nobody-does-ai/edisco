#!/usr/bin/perl
use lib "lib";
use common::sense;
use Carp::Always;
use autodie;
use DBI;
use Time::HiRes qw(sleep );
use DBD::Pg qw(:pg_types); # Required for PGRES constants if needed
use Nobody::Util;
use Nobody::PP;
use TsvDB;
use GD::Image;
use GD;
use GDUtil;
use TsvUtil qw(group_find);

$|++;

our(@VERSION) = qw( 0 1 0 );

use Path::Tiny;
our(%marker);
sub show {
  return;
  my($pg,$ln)=(shift,shift);
  for my $word(@_) {
    eex( { a=>$pg, b=>$ln, y=>{ map { $_, $word->$_() } qw( y1 y2 dy ) } } );
    eex( $word->text() );
  };
};
sub count {
  our(%cnt);
  for(@_) {
    $cnt{+refaddr($_)}++;
  };
  eex(%cnt);
};
sub hgroup_find {
  local(@_)=@_;
  local(*_)=shift;
  return unless @_;
  my($i)=0;
  my(@word)=shift;
  my($right)=$word[0]->x2;
  while(@_ and $_[0]->cx<$right) {
    my($word)=shift;
    push(@word,$word);
    $right=$word->x2 if $right<$word->x2;
  }
  sort { $a->x1 <=> $b->x1 } @word;
};
sub doc_upsert {
  my($doc,$file,$page)=@_;
  state($sth);
  $sth//=dbh->prepare(
    "insert into doc(doc,file,pages) values (?,?,?) ".
    "on conflict (file) do update set ".
    "doc=excluded.doc,  pages=excluded.pages ".
    "returning doc"
  );
  eex($doc,$file,$page);
  $sth->execute($doc,$file,$page);
  my($doc)=$sth->fetchrow_array;
  return $doc;
}
sub pages_to_multirange {
  my(@page)=sort { $a <=> $b } keys %{ +{ map { 0+$_, 1 } @_ } };
  my(@range);
  while(@page) {
    my($lo)=shift(@page);
    my($hi)=$lo+1;
    while(@page and $page[0] == $hi) {
      $hi++;
      shift(@page);
    };
    push(@range,"[$lo,$hi)");
  };
  return "{".join(",",@range)."}";
}
sub tsv_fname_parts {
  my($base)=@_;
  my($file,$page) = $base =~ m{^(.+)-([0-9]+)$};
  die "bad tsv filename '$base' (expected <doc>-<page>.tsv)" unless defined $file;
  $file =~ m{^([0-9]{4})-Q([1-4])(?:\b|-) };
  return ($file,0+$page);
}
sub png {
  return path("png")->child($_[0]->basename(".tsv").".png");
};
sub img {
  return undef;# GD::Image->newFromPng("$_[0]");
};
my(%trash);
my(%trig);
INIT {
  %trig=(
    qw(
    TRANSACTIONS 2
    INVESTMENTS 2
    KEY 1
    INSURED 1
    Page 1
    Program 1
    )
  );
  my($txt)=chr(0xc2).chr(0xa2);
  for(qw( SY . I IB [| Il ll Re I lo] e eo ] [ ifaveclized - ), $txt) {
    $trash{$_}=1;
  };
  for(    qw{ Investment Domestic Cash of SEI }  ) {
    $trash{$_}=0;
  };
  $trash{Yotal}=\"Total";
  $trash{"(continue)"}=\"[CONTINUE]";
  $trash{"(continuep)"}=\"[CONTINUE]";
  $trash{"(conTinuep)"}=\"[CONTINUE]";
  $trash{"(conTinue)"}=\"[CONTINUE]";
  $trash{"account:"}=\"account:";
  $trash{"Numberios"}=\"Numbers";
  $trash{"Accounts\xE2\x80\x99"}=\"Accounts";
  $trash{"Rem"}=1;
  $trash{"sanuary"}=\"January";
  $trash{ACCT}=\"ACCT";
};
sub no_trash {
  my(@word)=grep { $_->{level} == 5 } @_;
  for(@word) {
    our($text,$conf);
    local(*text)=\$_->{text};
    local(*conf)=\$_->{conf};
    if($conf<70) {
      my($trash)=$trash{$text};
      if(defined($trash)) {
        if($trash==0){ 
          $conf=90;
          $text=$conf=$_=undef;
        } elsif ( ref($trash) eq "SCALAR" ) {
          $text=${$trash};
          $conf=90;
        } else {
          $text=$conf=$_=undef;
        };
      } elsif($text =~ m{^account.s}){
        $text="account(s)";
        $conf=90;
      } elsif($text eq "&") {
        $text="and";
        $conf=90;
        $conf=90;
      } elsif($text =~ m{[0-9]} and $text =~ m{^[0-9\$.,A-]+$}) {
        $conf=90;
        $text =~ s{A}{4}g;
      }
      next if($conf>70);
      next unless defined and defined $text;
#          eex($conf, $text, $trash{$text});
      if($conf<20 and $conf>0){
#            eex( { text=>$text, conf=>$conf } );
        $_=undef;
      };
      if($trash{$text}){
        push(@{$trash{$text}},$_);
        $_->{reject}=1;
        $_=undef;
      };
    }    
  };
  grep { !$_->{reject} } grep { defined } @word;
}
sub filter {
  my(@word)=splice(@_);
  my($page);
  @word = sort { $a->page <=> $b->page or $a->y1 <=> $b->y1 or $a->x1 <=> $b->x2 } @word;
  return @word unless @word;
  while(@word) {
    my($group)=[shift @word];
    push(@_,$group);
    while(@word and !$trig{$word[0]->text}){
      push(@$group,shift(@word));
    }
    if(@word and $trig{$word[0]->text}==2){
      push(@_,$group=[]);      
    } else {
      splice(@word);
    };
  };
  return @_;
};
sub main
{
  my(@l,$all);
  my($dbh)=dbh;
  local($SIG{__DIE__})=sub { $DB::single=1; die @_; };
  local($SIG{__WARN__})=sub { $DB::single=1; warn @_; };
  eval {
    $dbh->begin_work;
    $dbh->do("delete from tsv");
    $dbh->do("delete from doc");
    my(%page,%doc);
    my(@todo)=sort glob("tsv/202?-Q?-???.tsv");
    die "no files provdied" unless @todo;
    for my $file(@todo){
      my($path)=path($file);
      my($base)=$path->basename(".tsv");
      my($doc_file,$page)=tsv_fname_parts($base);
      $page{$file}={ path=>$path, page=>$page, file=>$doc_file };
      push(@{$doc{$doc_file}{page}},$page);
    }
    my($doc_id)=0;
    for my $doc_file(sort { $a cmp $b } keys %doc) {
      my($rec)=$doc{$doc_file};
      my($page)=scalar(@{$rec->{page}});
      $rec->{doc}=++$doc_id;
      doc_upsert($rec->{doc},$doc_file,$page);
    };
    my(@all);
    for my $pg(sort keys %page) {
      eex({pg=>$pg});
      my($prec)=$page{$pg};
      my($doc_file,$path,$page)=@{$prec}{qw(file path page)};
      my($doc)=$doc{$doc_file}{doc};
      my(@word)=TsvWord->parse_file($path);
      @word=no_trash(@word);
      for(@word) {
        $_->{doc}=$doc;
        $_->{reject}//=0;
        $_->{page_num}=0+$page;
      };
      push(@all,@word);
    };
    eex(scalar(@all));
    tsv_insert(@all);
    $dbh->commit;
  };
  if("$@") {
    my($err)="$@";
    eval { $dbh->rollback };
    die $err;
  }
};
main;
END {
  my($log);
  $log=path("trash.log");
  $log->spew(pp(\%trash));
};
