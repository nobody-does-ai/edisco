#!/usr/bin/perl
use common::sense;
use autodie;
use DBI;
use DBD::Pg qw(:pg_types); # Required for PGRES constants if needed
use Nobody::Util;
use Nobody::PP;

$|++;

our(@VERSION) = qw( 0 1 0 );

# 1. Establish DBI connection
my $dsn = "dbi:Pg:dbname=nn";
my $dbh = DBI->connect($dsn, "", "", { 
  AutoCommit => 1, 
  RaiseError => 1, 
  PrintError => 0 
});

my($tsv, @tsv) = sort glob("tsv/202?-Q?-???.tsv");
my $count = 0;
my $one = 1;

# Optional: Trace equivalent in DBI
# $dbh->trace(2, "trace.pg");

foreach my $file ($tsv, @tsv) {
  my @l = path($file)->lines;
  
  if ($one) {
    # Extract headers from the first file
    my $header_line = shift @l;
    my @headers = split(m{[\n\t]}, $header_line);
    
    for (@headers) {
      $_ = substr($_, 0, 1) if m{^(left|top|width|height)};
      s{_num$}{};
    }

    # 2. Start the COPY process
    my $columns = join(", ", @headers);
    $dbh->do("COPY tsv ($columns) FROM STDIN WITH (FORMAT text, DELIMITER E'\t', NULL '\\N')");
    $one = 0;
  } else {
    shift @l; # Skip header for subsequent files
  }

  # 3. Stream data using pg_putcopydata
  foreach (@l) {
    $count++;
    $dbh->pg_putcopydata($_); 
  }
}

# 4. Finalize the COPY operation
$dbh->pg_putcopyend();

say "Total rows processed: $count";

$dbh->disconnect;
