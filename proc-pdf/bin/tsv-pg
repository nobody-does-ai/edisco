my(%acct,%cat);
INIT {
  %acct;
  @sec_cols = qw(sym name);
  @inv_cols = qw(
    qtr   acct  cat
    sym   nshares sharep
    value basis  unreal
  );
  @xdb_cols = qw(
    qtr   acct  date
    kind  cparty sym
    units uprice rate
    total descr
  );
  $DB::single=1;
  %cat = map { $_->[0], {cat=>$_->[0],descr=>$_->[1]}, } map { @$_ } PgDb->fetchall_arrayref("select cat, descr from cat");
  for(keys %cat) {
    $cat{$cat{$_}{descr}}=$cat{$_};
  };
  eex(\%cat);
};
sub parse_ivst {
  my($account);
  local(*_)=\@ivst;
  while(@_){
    local($_)=shift;
    die "undef ".pp(@_) unless defined;
    my($text)=group_text($_);
    local(@_)=@{$_};
    my($qtr)=$_[0]->{key};
    local($_)=map { split } $_[0]->text;
#        eex($_,$text);
    if($text =~ m{^(Total value|Number of|Share price|shares)}i){
#          eex($_);
    }elsif($text eq "Date Description Amount"){
#          eex($_);
    }elsif(m{INVESTMENTS}) {
#          eex($_);
    } elsif(m{^(\d+)$}){
#          eex("ACCOUNT: $1");
      $account=$1;
      $acct{$1}=$text;
      next;
    } elsif( $text=~m{^Total (for $account)}i) {
      $account=undef;
    } elsif( $cat{$_} or $cat{$text} ) {
      $ivsts[-1]{cat} = $cat{$text}{cat} if @ivsts;
    } else {
#          eex("INVESTMENT");
      my(@nums);
#          eex(group_text(\@_)); 
      while(@_ && is_num($_[-1]->text)){
        unshift @nums, clean_num((pop @_)->text);
      };
      die "I DIE!", pp({account=>$account, ivst=>$ivst[0]}) unless @nums;
      my($desc)=join(' ', map{$_->text//''}@_);
      next unless $desc =~ /\w/;
      next if $desc =~ /^Total\b/i;
      my($num,$sprice,$total,$basis,$unreal);
      if    (@nums==5){ ($num,$sprice,$total,$basis,$unreal)=@nums }
      elsif (@nums==4){ ($sprice,$total,$basis,$unreal)=@nums }
      elsif (@nums==3){
        # Some fixed-income rows only expose par amount, price, and market value.
        if(($nums[1]+0) > 0 && ($nums[1]+0) < 200 && ($nums[2]+0) > ($nums[1]+0) * 10){
          ($num,$sprice,$total)=@nums;
        } else {
          ($total,$basis,$unreal)=@nums;
        };
      };
      my(%h)=(
        name => norm_space($desc),
        qtr  => $qtr,
        acct => $account,
        cat  => undef,
      );
      $h{nshares} = $num    if defined $num;
      $h{sharep}  = $sprice if defined $sprice;
      $h{value}   = $total  if defined $total;
      $h{basis}   = $basis  if defined $basis;
      $h{unreal}  = $unreal if defined $unreal;
      $h{sym}     = title_key($h{name});
      push(@ivsts,\%h);
    };
  };
  my(%securities);
  for my $r(@ivsts){
    $securities{$r->{sym}}=$r->{name} if defined $r->{sym};
  };
  my(@secs)=map { {sym=>$_, name=>$securities{$_}} } sort keys %securities;
  PgDb->copy_bulk("sec",  [@sec_cols], [@secs]);
  PgDb->copy_bulk("inv",  [@inv_cols], [@ivsts]);
  for my $k (keys %acct) {
    my($a,$n) = ($k, $acct{$k});
    $a =~ s/'/''/g; $n =~ s/'/''/g;
    PgDb->execute("INSERT INTO acct (acct, name) VALUES ('$a','$n') ON CONFLICT DO NOTHING");
  };
  say STDERR join("\t", "inv:", 0+@ivsts, "sec:", 0+@secs);
};
