#!/usr/bin/perl
use common::sense;
use autodie;
use DBI;
use Time::HiRes qw(sleep );
use DBD::Pg qw(:pg_types); # Required for PGRES constants if needed
use Nobody::Util;
use Nobody::PP;
use TsvDB;

$|++;

our(@VERSION) = qw( 0 1 0 );

my(@tsv)=map { path($_) } sort glob("tsv/*-???.tsv");
use Path::Tiny;
{
  my(@all);
  for my $page(values %{page()}) {
    my($lpage)=$page->{id};
    $page=$page->{name};
    my($file)=path("tsv")->child($page);
    my(@lines)=grep { m{^[0-5]} } $file->lines;
    for(@lines) {
      chomp;
      local(@_)=split(m{\t});
      $_[1]=$lpage;
      push(@_,undef) while(@_<12);
      $_=join("\t",@_)."\n";
    };
    push(@all,@lines);
  };

  eex( dbh->selectall_array( "select count(*) from tsv" ) );
  dbh->do("delete from tsv");
  eex( dbh->selectall_array( "select count(*) from tsv" ) );
  ins_tsv(@all);
  eex( dbh->selectall_array( "select count(*) from tsv" ) );
};
dbh->disconnect;
