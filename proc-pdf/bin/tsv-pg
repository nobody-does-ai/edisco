my(@sec_cols,@inv_cols,@xdb_cols);

sub is_num { ($_[0]//'') =~ m{^-?(?:[\d,]+(?:\.\d+)?|\.\d+)$} }
sub clean_num { 
  local($_)=shift;
  $_=$_->text if ref $_;
  if(defined) {
    s{[.]}{} if m{[.].*[.]};
    s{S}{5}g; 
    s/[\$,]//g;
  };
  $_
}
sub norm_space { my $s=shift//return ''; $s=~s/\s+/ /g; $s=~s/^\s+|\s+$//g; $s }
sub fmt_money { sprintf('%.2f', $_[0]) }
sub title_key {
  my($s)=@_;
  return undef unless defined $s;
  $s=norm_space($s);
  if($s =~ /\(([A-Z][A-Z0-9]{1,9})\)/){
    return "AH_$1";
  };
  my($base)=$s;
  $base=~s/\([^)]*\)//g;
  my(@tok)=grep{length}($base =~ /([A-Za-z0-9]+)/g);
  my($acro)=join('', map { uc substr($_,0,1) } @tok);
  return undef unless length $acro;
  return "AH_$acro";
}
sub xact_kind {
  my($desc)=@_;
  return 'income_dividend' if $desc =~ /\bCash Dividend\b/i;
  return 'income_capgain_long' if $desc =~ /\bLong Term Capital Gain Distribution\b/i;
  return 'income_capgain_short' if $desc =~ /\bShort Term Capital Gain Distribution\b/i;
  return 'income_interest' if $desc =~ /\bDaily Rate Income\b/i;
  return 'income_interest' if $desc =~ /\bInterest Payment\b/i;
  return 'fee' if $desc =~ /\bFee\b/i;
  return 'transfer_out' if $desc =~ /\b(?:Cash Transfer|Cash Disbursement|Normal Distribution To)\b.*\bWithdrawal\b/i;
  return 'trade_buy' if $desc =~ /^Purchase\b/i;
  return 'trade_sell' if $desc =~ /^Sale\b/i;
  return 'transfer_in' if $desc =~ /\bDeposit\b/i;
  return 'other';
}
sub xact_counterparty {
  my($desc)=@_;
  return $1 if $desc =~ /\b(?:To|account)\s+(\d{5,10}[A-Z]*)\b/i;
  return undef;
}
sub parse_trade_security {
  my($desc)=@_;
  return unless $desc =~ /^(Purchase|Sale)\s+([\d,]+(?:\.\d+)?|\.\d+)\s+Units\s+of\s+(.+?)\s+\@\s+\$?([\d,]+(?:\.\d+)?|\.\d+)$/i;
  return (
    units  => clean_num($2),
    name   => norm_space($3),
    uprice => clean_num($4),
  );
}
sub parse_dividend_security {
  my($desc)=@_;
  return unless $desc =~ /\bCash Dividend\s+([\d,]+(?:\.\d+)?)\s+USD\s+(.+?)\s+For\s+([\d,]+(?:\.\d+)?)\s+(Units|Shares)\b/i;
  return (
    rate       => clean_num($1),
    name       => norm_space($2),
    units      => clean_num($3),
    units_kind => lc($4),
  );
}
sub parse_capgain_security {
  my($desc)=@_;
  return unless $desc =~ /\b(?:Long|Short)\s+Term Capital Gain Distribution\s+([\d,]+(?:\.\d+)?)\s+USD\s+(.+?)\s+For\s+([\d,]+(?:\.\d+)?)\s+(Units|Shares)\b/i;
  return (
    rate       => clean_num($1),
    name       => norm_space($2),
    units      => clean_num($3),
    units_kind => lc($4),
  );
}
sub parse_income_security {
  my($desc)=@_;
  return unless $desc =~ /\bDaily Rate Income on\s+(.+?)\s+For Period of\b/i;
  return (
    name => norm_space($1),
  );
}
sub signed_amount {
  my($desc,$amount)=@_;
  return undef unless defined $amount;
  $amount=clean_num($amount);
  return undef unless defined $amount && length $amount;
  my($abs)=$amount; $abs=~s/^-//;
  return "-$abs" if $desc =~ /(?:^Purchase\b|Fee\b|Withdrawal\b)/i;
  return $abs   if $desc =~ /(?:^Sale\b|Dividend\b|Income\b|Deposit\b)/i;
  return $amount;
}
sub infer_dividend_amount {
  my($desc,$amount)=@_;
  return $amount unless defined $amount && $amount =~ /^\d+$/;
  return $amount unless $desc =~ /\b(?:Cash Dividend|(?:Long|Short)\s+Term Capital Gain Distribution)\s+(\d+(?:\.\d+)?)\s+USD\b/i;
  my($rate)=$1;
  return $amount unless $desc =~ /\bFor\s+([\d,]+(?:\.\d+)?)\s+(?:Units|Shares)\b/i;
  my($qty)=clean_num($1);
  my($want)=sprintf('%.2f',$rate * $qty);
  my($got)=$amount + 0;
  return $want if $got >= 100 && abs(($got/100) - $want) < 0.02;
  return $want if $got >= 1000 && abs(($got/1000) - $want) < 0.02;
  return $amount;
}
sub infer_trade_amount {
  my($desc,%t)=@_;
  return undef unless defined $t{units} && defined $t{uprice};
  my($amt)=fmt_money(($t{units}+0) * ($t{uprice}+0));
  return "-$amt" if $desc =~ /^Purchase\b/i;
  return $amt if $desc =~ /^Sale\b/i;
  return undef;
}
sub is_xact_continuation {
  my($row,$text)=@_;
  return 1 if($row->[0]->x1 > 450);
  return 0 unless defined $text && length $text;
  return 0 if is_header_noise($text) || is_account($text);
  return 1 if $text =~ /^(?:Ex Date\b|Date\b|account:|AUA Platform Fee:)/i;
  return 1 if $text =~ /^Date\s/i;
  return 1 if $text =~ m{^\d{1,2}/\d{2}/\d{2}\b};
  return 1 if $text =~ m{1.00 For [\d.]+ Units};
  return 1 if $text =~ m{With Ex Date};
  return 0;
}
sub reparse_xact {
  my($x)=@_;
  return unless $x;
  my($desc)=$x->{descr};
  if(my(%t)=parse_trade_security($desc)){
    %{$x}=(%{$x},%t);
    $x->{total}=infer_trade_amount($desc,%t);
  } elsif(my(%t)=parse_dividend_security($desc)){
    %{$x}=(%{$x},%t);
    $x->{total}=infer_dividend_amount($desc,$x->{total});
  } elsif(my(%t)=parse_capgain_security($desc)){
    %{$x}=(%{$x},%t);
    $x->{total}=infer_dividend_amount($desc,$x->{total});
  } elsif(my(%t)=parse_income_security($desc)){
    %{$x}=(%{$x},%t);
  };
  $x->{kind}=xact_kind($desc);
  $x->{cparty}=xact_counterparty($desc);
  $x->{sym}=title_key($x->{name}) if defined $x->{name};
  return $x;
}
sub is_header_noise {
  my($text)=@_;
  return 1 if $text =~ m{^(?:Date\b|Number\b|Page\b|A CONSOL|COVERING|HOW MY)}i;
  return 1 if $text =~ /^(?:Date Description Amount|Total value\b|Total For\b)/i;
  return 1 if $text =~ /\bcontinue[dn]?\b/i;
  return 0;
}
sub is_cat {
  my($text)=@_;
  return 0 unless defined $text && $text =~ /\w/;
  return 0 if $text =~ /\d/;
  return 0 if is_header_noise($text);
  return 0 if $text =~ /\b(?:Trust|Ara|Shirley|Paul|U\/A|DTD|Account)\b/i;
  return 1;
}

my(%sect);
our(@xact,@ivst);
our(@xacts,@ivsts);
our($sect);
INIT {
  $sect{TRANSACTIONS}={name=>'xact', rows=>\@xact};
  $sect{INVESTMENTS}={name=>'ivst', rows=>\@ivst};
  local(@_)=( 'Total Value',  qw{ Program  none  INSURED  Page  } );
  for(@_) {
    $sect{$_}={name=>$_, []};
  };
};
sub parse_xact {
  local(@_)=@_;
  my(@xacts);
  my($account);
  $account=shift;
  my($desc_x)=10000000;
  while(@xact){
#        eex($_);
    my($row)=shift(@xact);
    local($_)=$row->[0]->text;
    my($w)=split;
#        eex($desc_x, $row->[0]->x1);
#        eex(group_text($row));
    if(m{TRANSACTIONS}){
#          eex("TRANSACTIONS: ",scalar(@xact));
    } elsif(@xacts && $row->[0]->x1 >= $desc_x){
#          eex($xacts[-1]);  
      $xacts[-1]{descr}=norm_space("$xacts[-1]{descr} $_");
      $xacts[-1]=reparse_xact($xacts[-1]);
#          eex($xacts[-1]);  
    }elsif(is_account($_)){
#          eex({account=>$account});
      $account=(split(/\s+/,$_))[0];
#          eex({account=>$account});
    }elsif(is_header_noise($_)){
#          eex("noise: $_");
      next;
    }elsif(m{^\d{1,2}/\d{2}/\d{4}$}){
#          eex($desc_x);
      $desc_x=min($desc_x,$row->[1]->x1);
#          eex($desc_x);
      my(%x)=(
        date  => $_,
        descr => $row->[1]->text,
        reported_amount => clean_num($row->[2]),
        total => clean_num($row->[2]),
        qtr   => $row->[0]->{key},
        acct  => $account,
      );
#          eex(\%x);
      my($desc)=$row->[1]->text;
      $x{total}=infer_dividend_amount($desc,$x{total});
      $x{total}=signed_amount($desc,$x{total});
      my($x)=reparse_xact(\%x);
#    #          eex($x);
      push(@xacts,$x);
    } else {
#          eex("skip: $_");
      next;
    };
  };
  PgDb->copy_bulk("xact", [@xdb_cols], [@xacts]);
  say STDERR "xact:\t".scalar(@xacts);
};


sub is_account {
  my($text)=@_;
  my(@tok)=split(/\s+/,$text);
  return 0 unless @tok >= 2;
  return 0 unless $tok[0] =~ /^\d{5,10}$/;
  return !is_num($tok[-1]);
};
sub statement_file_for {
  my($key)=@_;
  for my $dir(qw(src pdf)){
    for my $ext(qw(pdf)){
      my($file)="$dir/$key.$ext";
      return $file if -f $file;
    };
  };
  return undef;
}

sub xact {
  say scalar(@_), " xact";
}
sub ivst {
  say scalar(@_), " ivst";
};
sub parse;
sub main {
  my(%doc);
  my(@files) = glob("tsv/*.tsv");
  PgDb->execute("truncate table inv");
  PgDb->execute("truncate table sec");
  PgDb->execute("truncate table xact");
  @files=sort(@files);
  my(%file);
  for my $file(@files){
    next unless -s $file;
    my($p)=path($file);
    my($key,$page)=($file=~m{/(\d\d\d\d-Q\d).*(\d\d\d)[.]});
    die pp($p) unless defined $key;
    $file{$key}{'P'.$page}=$p;
  };
  my(@word);
  my($base,$next)=(0,0);
  my($pageno)=0;
  $sect=$sect{Page};
  for my $key(sort keys %file) {
    my(%page)=%{$file{$key}};
    for my $page(sort keys %page) {
      my($file)=$page{$page};
      my($tsv)=TsvFile->new($file);
      my(@word)=(@{$tsv->word});
      my(@row)=@{rows_find(\@word)};
      for my $row(@row){
        $row->[0]->{key}=$key;
        $row->[0]->{page}=$page;
        my($text)=map { split } $row->[0]->text;
        $sect=$sect{$text}//$sect;
        push(@{$sect->{rows}},$row);
      };
    }
  };
  parse_ivst;
  parse_xact;
};
