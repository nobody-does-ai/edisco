#!/usr/bin/perl
use lib "lib";
use common::sense;
use autodie;
use DBI;
use Time::HiRes qw(sleep );
use DBD::Pg qw(:pg_types); # Required for PGRES constants if needed
use Nobody::Util;
use Nobody::PP;
use TsvDB;
use GD::Image;
use GD;
use GDUtil;
use TsvUtil qw(group_find);

$|++;

our(@VERSION) = qw( 0 1 0 );

use Path::Tiny;
our(%marker);
sub show {
  return;
  my($pg,$ln)=(shift,shift);
  for my $word(@_) {
    eex( { a=>$pg, b=>$ln, y=>{ map { $_, $word->$_() } qw( y1 y2 dy ) } } );
    eex( $word->text() );
  };
};
sub count {
  our(%cnt);
  for(@_) {
    $cnt{+refaddr($_)}++;
  };
  eex(%cnt);
};
sub hgroup_find {
  local(@_)=@_;
  local(*_)=shift;
  return unless @_;
  my($i)=0;
  my(@word)=shift;
  my($right)=$word[0]->x2;
  while(@_ and $_[0]->cx<$right) {
    my($word)=shift;
    push(@word,$word);
    $right=$word->x2 if $right<$word->x2;
  }
  sort { $a->x1 <=> $b->x1 } @word;
};
sub png {
  return path("png")->child($_[0]->basename(".tsv").".png");
};
sub img {
  return undef;# GD::Image->newFromPng("$_[0]");
};
my(%trash);
sub main
{
  my(@l);
  local($SIG{__DIE__})=sub { $DB::single=1; die @_; };
  local($SIG{__WARN__})=sub { $DB::single=1; warn @_; };
  eval {
    dbh->do("delete from tsv");
  };
  my(%page)=map{$_,{path=>path($_)}}sort glob("tsv/202?-Q?-???.tsv");
  for( values %page ) {
    $_=[map { 0+$_ || $_ } split(m{[/.-]Q?}, path($_->{path})->basename(".tsv")),$_->{path}];
  }
  my(@all);
  my($l)=0;
  for(qw( ll I lo] e eo ] [ ifaveclized )) {
    $trash{$_}=[];
  };
  {
    my($txt)=chr(0xc2).chr(0xa2);
    $trash{$txt}=[];
  };
  for my $pg(sort keys %page) {
    my($prec)=$page{$pg};
    my($y,$q,$p,$page)=@{$prec};
    eex($page);
    my(@word)=TsvWord->load_file($page);
    my($png)=png($page);
    my($img)=img($png);
    @word = grep { defined and $_->level==5 } @word;
    for(@word) {
      my($text)=$_->{text};
      my($conf)=$_->{conf};
      if($conf<70) {
        if($_->text eq "(continue)") {
          $conf=90;
          $text="(CONTINUED)";
          $_->{reject}=0;
        } elsif($conf<20 and $conf>0){
          if($text =~ m{[0-9]} and $text =~ m{^[0-9\$.,A-]+$}){
            say STDERR "LC NUM:  ",pp($text);
            push(@{$trash{$text}},$_);
            $_->{reject}=0;
            next;
          } else {
            say STDERR "lc text: ",pp($text);
            $_->{reject}=1;
          };
        } else {
          eex("lc: ", $conf, $text);
        };
        if($trash{$text}){
          push(@{$trash{$text}},$_);
          $_->{reject}=1;
          $_=undef;
        };
      }    
    };
    @word = grep { blessed($_) and defined and $_->level==5 } @word;

    for(@word) {
      $_->{page}=$p;
      $_->{y}=$y;
      $_->{q}=$q;
      $_->{reject}//=0;
    };
    my($width)=$word[0]->width;
    my(@line);
    if($word[0]->text eq "POLLOCK") {
      local(@_)=shift(@word);
      push(@_, grep { $_->text eq "Investment" or $_->text eq "Advisors" } @word);
      eex(@_);
      push(@line,TsvLine->from(@_));
    }
    push(@line,TsvLine->from(@word));
    my(@w);
    my($last);
    for my $line(@line)
    {
      $line->{line}=++$l;
      for(@{$line->word}){
        $_->{line}=$l;
        push(@w,$_);
      };
    };
    push(@all,splice(@word));
  };
  tsv_insert(@all);
  dbh->disconnect;
};
main;
END {
  my($log);
  $log=path("trash.log");
  $log->spew(pp(\%trash));
};
