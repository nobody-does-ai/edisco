INIT {
  @sec_cols = qw(key name);
  @inv_cols = qw(
    qtr   acct  cat
    key   nshares sharep
    value basis  unreal
  );
  @xdb_cols = qw(
    qtr   acct  date
    kind  cparty name
    units uprice rate
    total descr
  );
};
