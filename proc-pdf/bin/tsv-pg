#!/usr/bin/perl
use common::sense;
use autodie;
use DBI;
use Time::HiRes qw(sleep );
use DBD::Pg qw(:pg_types); # Required for PGRES constants if needed
use Nobody::Util;
use Nobody::PP;
use TsvDB;

$|++;

our(@VERSION) = qw( 0 1 0 );

use Path::Tiny;
our(%marker);
sub main
{
  my(@page)=map{path($_)}sort glob("tsv/202?-Q?-???.tsv");
  dbh->do("delete from tsv");
  my(%trig);
  $trig{INVESTMENTS}=2;
  $trig{TRANSACTIONS}=2;
  $trig{Page}=1;
  my(@all);
  for my $p(keys @page) {
    my($page)=$page[$p];
    $p+=1000;
    my(@line)=TsvLine->load_file($page);
    my($i)=1000;
    for(@line) {
      my(@word)=@{$_->word};
      ++$i;
      for (@word){
        $_->{line}=$i;
        $_->{page}=$p;
      }
      push(@all,@word);
    };
    say scalar(@all);
  };
  say scalar(@all);
  @all=TsvUtil::vsort(@all);
  tsv_insert(@all);

  dbh->disconnect;
};

main;
