#!/usr/bin/perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use lib "lib";
use common::sense;
use autodie;
use Nobody::Util;
use Nobody::JSON qw(json);
use TsvDB;
sub html;
sub td;
sub rows_for;
my(@ivest_cols,@xact_cols,@idb_cols,@xdb_cols);
my($NimCrut)='1603387';
@ARGV=glob("json/202[0-9]-Q[0-9]*.json") unless @ARGV;
main(@ARGV);
exit(0);
sub main {
  my(@nimcrut);
  @_=sort map { path($_)->basename(".json") } @_;
  my(%data);
  our(@xact,@ivest);
  for my $json_file(map{path($_)}map { "json/$_.json" } sort @_){
    my($data)=json->load($json_file);
    push(@xact,rows_for($data,'transactions'));
    push(@ivest,rows_for($data,'investments'));
  }
  @xact=xrekey(@xact);
  @ivest=irekey(@ivest);
  TsvDB->insert("inv",[@idb_cols],[@ivest]);
  TsvDB->insert("xact",[@xdb_cols],[@xact]);
}
my(%xli,%xlx);
sub irekey {
  for (keys @_){
    my $ivest=$_[$_];
    my(%ivest);
    for(keys %xli){
      $ivest{$xli{$_}}=delete $ivest->{$_};
    };
    $_[$_]=\%ivest;
  };
  @_;
};
sub xrekey {
  for (keys @_){
    my($xact)=$_[$_];
    my(%xact);
    for(keys %xlx){
      $xact{$xlx{$_}}=delete $xact->{$_};
    };
    $_[$_]=\%xact;
  };
  @_;
};

sub rows_for {
  my($data,$key)=@_;
  my(@rows);
  push @rows, @{$data->{$key}//[]};
  return @rows;
}


INIT {
  @ivest_cols= qw(
  statement_id   account_number  category
  security_name  shares          share_price
  market_value   cost_basis      unrealized_gain
  security_key                   
  );
  @idb_cols= qw(
  qtr   acct  cat
  tick  nshares sharep
  value   basis      unreal
  key                   
  );
  %xli=map { $ivest_cols[$_], $idb_cols[$_] } keys @idb_cols;
  @xact_cols= qw(
  statement_id  account_number        business_date
  kind          counterparty_account  security_name
  units         unit_price            rate
  cash_amount   description_raw       
  );
  @xdb_cols= qw(
  qtr  acct        date
  kind          cparty  name
  units         uprice            rate
  total   descr       
  );
  %xlx=map { $xact_cols[$_], $xdb_cols[$_] } keys @xdb_cols;
};
