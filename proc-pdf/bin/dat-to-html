#!/opt/bin/vi-perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use autodie;
use common::sense;
use Carp qw( croak confess carp cluck );
use Carp::Always;
use Nobody::Util;
use Tsv; use TsvUtil; use TsvWord;
use TsvLine;
our(@VERSION) = qw( 0 1 0 );
our(%data);
(*data)=require(path("dat/all.dat.pl")->absolute->stringify);
sub row {
  local(@_)=@_;
  my($extra)=(@_>1?"":'colspan="4"');
  $_="  $_" for @_;
  @_=map { ("<td $extra>", $_, "</td>") } @_;
  $_="  $_" for @_;
  unshift(@_,"<tr>");
  push(@_,"</tr>");
  @_;
};
sub formdate {
  local(*_)=$_[0];
  my($m,$d,$y)=m{(\d\d)/(\d\d)/(\d\d\d\d)};
  return undef unless defined $y;
  $_=join("-",$y,$m,$d); 
  return 1;
};
my($acct,$y,$q);
sub trn {
  my($trn)=shift;
  local(*_)=$trn->word;
  local($_)=$_[0];
  @_=map { $_->text } @_;
  for($_[0]) {
    local($")=" ";
    if($_ eq "Date" or $_ eq "TRANSACTIONS"){
      return (); #row("Hdr", "header", "hdr");
    } elsif(@_>2 and formdate(\$_)) {
      my($date)=($_,shift);
      my($amnt)=pop;
      my($text)="@_";
      return row( $y,$q,$acct, $date, $text, $amnt );
    } elsif(@_>2 and m{^[0-9]+$}) {
      eex "@_";
      $acct=$_[0];
#          return row( "@_" );
    } else {
      return row("@_");
    };
    $_="**$_" for @_;
  };
};
sub main {
  our(@trn,@inv);
  my(@txt);
  push(@txt, "<table>");
  for ( sort keys %data ) {
    $y=$_;
    for ( sort keys %{$data{$y}} ) {
      $q=$_;
      local(*data)=$data{$y}{$q};
      if($data{trn}) {
        *trn=$data{trn};
        push(@txt, trn($_)) for @trn;
      }
    }
  }
  push(@txt, "</table>");
  path("trn.html")->touchpath->spew(@txt);
};
main(@ARGV);
