#!/opt/bin/vi-perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use common::sense;
use Tsv;
use autodie;
use Nobody::Util;
use TsvUtil;
use TsvWord;
use TsvText;
use Carp qw( croak confess carp cluck );
use Carp::Always;
use Tsv;
use TsvLine;
our(@VERSION) = qw( 0 1 0 );
sub proc_file;
my(%data);
my($y,$q);
my(%acct)=( "434097", "Idk?" );
sub main {
  local(@_)=@_;
  @_=map { path($_) } sort glob("tsv/202?-Q?.tsv") unless @_;
  die "no files" unless @_;
  for(@_) {
    local(@_)=map { split m{([/.-])} } $_->basename(".tsv");
    ($y,undef,$q)=@_;
    $data{$y}{$q}=proc_file($_);
  };
  $data{acct}=\%acct;
  use Data::Dumper;
  $Data::Dumper::Terse=1;
  $Data::Dumper::Sortkeys=1;
  path("dat/all.dat.pl")->touchpath->spew(Dumper(\%data));
};
sub find_accts {
  my(@i);
  my($a)=shift;
  my($n)="not-set";
  for my $i(0 .. @$a-1) {
    for( $a->[$i]->word(0)->text ) {
      if(m{^(16|4)\d\d\d\d\d$}){
        $n=$_;
        ($acct{$n},$a->[$i])=($a->[$i]->text,undef);
        for($acct{$n}) {
          s{\s*\(continued\)\s*}{};
          s{ UA }{ U/A };
        };
      } elsif ( $_ eq 'Total' ) {
        $a->[$i]=undef;
      } else {
        $a->[$i]->{anum}=$n;
      };
    };
  };
};
sub redate($) {
  my($m,$s1,$d,$s2,$y)=map { 
    m{^(\d\d)(.|)(\d\d)(.)(202[3456])$} 
  } $_[0];
  eex( {s1=>$s1, s2=>$s2} );
  if(3==grep{defined}($y,$m,$d)) {
    return join("-",$y,$m,$d);
  } else {
    return $_[0];
  };
};
sub fix_trn {
  our(@trn);
  *trn=shift;
  my($if)=shift;
  @trn = grep { $_->word(0)->text ne 'TRANSACTIONS' } @trn;
  @trn = grep { $_->text ne "Date Description Amount" } @trn;
  for(@trn) {
    $_->{y}=$y;
    $_->{q}=$q;
  };
  find_accts(\@trn);
  @trn = grep { defined } @trn;
  for(my $i=1;$i<$#trn;$i++){
    my($trn)=$trn[$i-1];
    my($nxt)=$trn[$i];
    next if $nxt->left <= 200;
    my($arr)=$trn->word;
    splice(@$arr,@$arr-1,0,"\n",@{$nxt->word});
    splice(@trn,$i,1);
    --$i;
  };
  for(@trn){
    local(*_)=$_->word;
    my($date)=shift->text;
    my($amnt)=pop->text;
    my($anum)=$_->{anum};
    my($odate)=$date;
    if(substr(redate($date),0,1)eq'-'){
      $DB::single=1;
    };
    $date=redate($date);
    eex([$odate,$date]);
    $_={date=>$date,text=>$_->text,amnt=>$amnt,anum=>$anum,y=>$y,q=>$q};
    $_->{file}="$if";
    for($_->{amnt}){
      s{,}{}g;
    };
  };
};
sub fix_inv {
  our(@inv);
  *inv=shift;
  my($if)=shift;
  my(%skip);
  $skip{'INVESTMENTS'}=1;
  @inv = grep { $_->word(0)->left < 620 } @inv;
  @inv = grep { !$skip{$_->word(0)->text} } @inv;
  find_accts(\@inv);
  @inv = grep { defined } @inv;
  for(my $i=1;$i<@inv;$i++){
    my($inv)=$inv[$i-1];
    my($nxt)=$inv[$i];
    splice(@inv,$i-1,2,[$inv,$nxt]);
  };
  my($pop);
  if(ref($inv[$#inv]) ne 'ARRAY'){
    $pop=pop(@inv);
    eex(ref($pop),$pop);
  };
  for(@inv) {
    die ref($_) unless ref($_) eq 'ARRAY';
    die pp($_) unless 2==@$_;
    my($inv,$nxt)=@$_;
    my($text)=$inv->text;
    my($num,$pri,$val,$basis,$ugain,@x);
    {
      local (*_)=$inv->word;
      @x=qw(# # # # #);
      for(1 .. 5) {
        last unless ($_[$#_]->text =~ m{^-?[0-9.,]+$});
        unshift(@x,map { $_->text } pop);
      };
      ($num,$pri,$val,$basis,$ugain)=splice(@x);
    };
    $_={ num=>$num, pri=>$pri, val=>$val, basis=>$basis, ugain=>$ugain };
    $_->{file}="$if";
    $_->{desc}=$inv->text;
    $_->{cat}=$nxt->text;
    $_->{anum}=$inv->{anum};
    $_->{y}=$y;
    $_->{q}=$q;
  };
};
sub check {
  my(@word)=@_;
  @word = sort { $a->cx <=> $b->cx } @word;
  my(%pos);
  for my $i(0 .. $#word){
    for($word[$i]) {
      for my $j($_->top .. $_->bottom) {
        push(@{$pos{$j}},$word[$i]->text);
      };
    };
  }
  eex(\%pos);
   
};
sub proc_file($) {
  my(@tmp)=@_;
  (@_)=map { "$_" } @_;
  local(@_)=@tmp;
  die "usage: proc_file(\$if)" unless @_==1;
  my(@all,@inv,@trn,@con,@act); 
  my($part)=\@all;
  my(%trig) = map { $_, $part } qw(
  TRANSACTIONS INVESTMENTS INSURED Page POLLOCK
  );
  $_=$part for(values %trig);
  $trig{TRANSACTIONS}=\@trn;
  $trig{INVESTMENTS}=\@inv;
  my($if)=shift;
  @_=TsvWord->load_file($if);
  @_=sort { $a->cy <=> $b->cy } @_;
#      check( grep { $_->level == 5 and $_->cy >= 4240 and $_->cy <= 4300 } @_);
  @_=TsvLine->from(@_);
  @_=sort { $a->cy <=> $b->cy } @_;
  my($trig);
  while(@_) {
    my($text)=$_[0]->word(0)->text;
    if($trig{$text}) {
      $part=$trig{$text};
    }
    push(@$part,shift);
  }
  @all=();
  fix_trn(\@trn,$if);
  fix_inv(\@inv,$if);
  { inv=>\@inv, trn=>\@trn, all=>\@all };
};
main(map { path($_) } @ARGV);
