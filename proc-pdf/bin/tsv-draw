#!/usr/bin/perl
use common::sense;
use autodie;
use Image::Magick;
use Nobody::Util;
use TsvWord;
use TsvLine;
use Statistics::Lite;
my @f = map { path($_) } sort glob("tsv/2024-Q1.tsv");
my $od = path("png");
sub do_file {
  my($if)=shift;
  my($of)=$od->child($if->basename(".tsv").".png");
  my(@tsv)=TsvWord->load_file($if);
  my($pg)=(grep { $_->level==1 } @tsv);
  my(@row)=sort { $a->cy <=> $b->cy } TsvLine->from(@tsv);
  my($img)=Image::Magick->new(size=>join("x",$pg->width,$pg->height));
  my($th)=text_height(@row);
  my $fixed_pointsize = $th * 0.8;
  $img->Read("xc:white");
  for my $w(@row) {
    $img->Annotate(
      text=>$w->text,
      pointsize=>$fixed_pointsize,
      fill=>'black',
      x=>$w->left,
      y=>$w->top+$fixed_pointsize,
      font=>'Liberation-Mono-Bold',
    );
  };
  $img->Write($of->touchpath->stringify);
};
for(@f){
  do_file($_);
};
sub text_height {
  local(@_)=@_;
  my(%h);
  for(@_){
    $h{$_->height}++;
  };
  my($mf)=max(values %h);
  my($m)=min(grep { $h{$_}==$mf } keys %h);
  $m;
};
__DATA__
my @tsv = TsvWord->load_file($in_file);
my @row = TsvLine->from(@tsv);
my (@page) = (sort { $a->cy <=> $b->cy } grep { $_->level == 1 } @tsv);
my ($top)=0;
for(@page) {
  $_->
};
exit(0);
my ($w,$h)=($page[0]->right,$page[0]->bottom);
my ($image)=Image::Magick->new(size => join('x',$w,$h));
my($th)=text_height(@row);
my $fixed_pointsize = $th * 0.8;
for my $w(@row) {
  $image->Annotate(
    text=>$w->text,
    pointsize=>$fixed_pointsize,
    fill=>'black',
    x=>$w->left,
    y=>$w->top+$fixed_pointsize,
    font=>'Liberation-Mono-Bold',
  );
};
say $image->Write($out_file);
