#!/usr/bin/perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use common::sense;
use autodie;
use Nobody::Util;
use Nobody::PP;
use TsvDB;
use GD::Image;
use GDUtil;
our(@VERSION) = qw( 0 1 0 );

sub main;
main(@ARGV);
exit(0);
use TsvLine;
my(%tgt);
my(@inv,@trn);
$|++;

sub invest {
  local(@_)=@_;
  for(@_) {
    say $_->text;
  };
};
sub main {
  my(@tsv)=map { path($_) } glob("tsv/202?-Q?-???.tsv");
  my($tsv,$png,@img);
  our(@range);
  local(@range)=@{tsv_fetch_range()};
  say scalar(@range);
  for(@range){
    local(*_)=$_->{tsv};
    my(@line)=grep { ref($_) eq 'TsvLine' } TsvLine->from(@_);    
    if($line[0]->text(0) eq 'INVESTMENTS') {
      invest(@line);
    };
  };
}

