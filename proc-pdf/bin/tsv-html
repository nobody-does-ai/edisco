sub nsort {
  sort { $a <=> $b } @_;
};
sub main {
  my(@tsv)=map { path($_) } glob("tsv/202?-Q?-???.tsv");
  my($tsv,$png,@img);
  our(%range);
  local(*range)=dbh->selectall_hashref("select * from tsv_range r where level=5 order by rid, tsv",["rid","tsv"]);
  my(@tr,@in);
  my(@line);
  for my $rid(nsort keys %range){
    my($range)=$range{$rid};
    my(@range)=sort { $a <=> $b } keys %$range;
    @range=map { $range{$rid}{$_} } @range;
    @range = TsvUtil::vsort(@range);
    my(@word)=TsvWord->from(@range);
    my(@line)=TsvLine->from(@word);
    if(substr($line[0]->text,0,1)eq'T') {
      push(@tr,[@line]);
    } elsif (substr($line[0]->text,0,1)eq'I') {
      push(@in,[@line]);
    } else {
      warn $line[0]->text;
    };
  };
#      transact(@tr);
  invest(@in);
}
my(%trig);
INIT {
  %trig=(
    qw(
    TRANSACTIONS 1
    INVESTMENTS 1
    INSURED 1
    Page 1
    Program 1
    )
  );
};
my(%hist);
sub avg { 
  return sum(@_)/@_;
};
my(%acct);
sub invest {
  local(@_)=@_;
  eex("enter invest");
  my($acct);
  for(@_){
    my($range)=$_;
    local(*_)=$range;
    {
      eex(map { $_->text } @_);
    };
    while(@_) {
      my($rstart)=map { $_->text } shift;
      while(@_ and $_[0]->text(0) !~ m{^\d+$}){
        my($skip)=shift;
        eex({skip=>$skip->text});
      }
      while(@_ and !$trig{$_[0]->text(0)}){
        my($line)=shift;
        my($text)=$line->text;
        my($wone)=$line->text(0);
        if($trig{$wone}) {
          eex{TRIGGERED=>'true'};
          eex({text=>$text});
          next;
        } elsif ($wone =~ m{^[0-9]+$}) {
          eex(acct=>$text);
          $acct{$wone}//=$text;
          $acct=[$line];
          next;
        } elsif($wone eq "Total"){
          eex(total=>$text);
          $acct=undef;
        } elsif(defined($acct)){
          eex({invest=>$text});
          push(@$acct,$_);
        } else {
          eex( { num=>0+@_, range=>"$range", line=>"$line", test=>"$text", wone=>"$wone" } );
        };
      };
    };
  };
  if(defined($acct)){
    die pp(acct=>$acct);
  };
};

    
