#!/usr/bin/perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use lib "lib";
use common::sense;
use autodie;
use Nobody::Util qw(path);
use JSON::PP;

my($out_dir)=path("html")->mkdir;

for my $file (sort glob("json/*.json")) {
  my($key)=path($file)->basename(".json");
  my($data)=JSON::PP->new->decode(path($file)->slurp);
  my(@xacts)=@{$data->{xact}//[]};
  my(@ivsts)=@{$data->{ivst}//[]};
  next unless @xacts || @ivsts;

  my($out)=$out_dir->child("$key.html");
  my $fh=$out->openw;
  print $fh html_head($key);
  print $fh ivst_table(@ivsts) if @ivsts;
  print $fh xact_table(@xacts) if @xacts;
  print $fh "</body></html>\n";
  say $out;
}

sub html_head {
  my($id)=@_;
  return <<"EOF";
<html><head><title>Statement $id</title><style>
body{font-family:sans-serif;padding:20px}
table{border-collapse:collapse;margin-bottom:30px;width:100%}
th{border:1px solid #999;padding:6px;background:#e0e0e0;text-align:left}
td{border:1px solid #ccc;padding:6px;font-family:monospace}
td.num{text-align:right}
tr:nth-child(even){background:#f9f9f9}
</style></head><body><h1>Statement: $id</h1>
EOF
}

sub xact_table {
  my $html = "<h2>Transactions</h2><table>\n";
  $html .= "<tr><th>Account</th><th>Date</th><th>Description</th><th>Amount</th></tr>\n";
  for my $r (@_) {
    $html .= sprintf "<tr><td>%s</td><td>%s</td><td>%s</td><td class=num>%s</td></tr>\n",
      $r->{account}//'', $r->{date}//'', $r->{desc}//'', $r->{amount}//'';
  }
  $html .= "</table>\n";
  return $html;
}

sub ivst_table {
  my $html = "<h2>Investments</h2><table>\n";
  $html .= "<tr><th>Account</th><th>Description</th><th>Shares</th><th>Price</th>"
         . "<th>Total</th><th>Basis</th><th>Unrealized</th></tr>\n";
  for my $r (@_) {
    $html .= sprintf "<tr><td>%s</td><td>%s</td><td class=num>%s</td><td class=num>%s</td>"
           . "<td class=num>%s</td><td class=num>%s</td><td class=num>%s</td></tr>\n",
      $r->{account}//'', $r->{desc}//'',
      $r->{num}//'', $r->{sprice}//'',
      $r->{total}//'', $r->{basis}//'', $r->{unreal}//'';
  }
  $html .= "</table>\n";
  return $html;
}
