  exit(0);
}
our(%tdump);
our($lvl)=0;
sub tdump {
  my($o)=shift;
  my($r)=ref($o);
  my($d)=$tdump{$r};
  if(defined($d)){
    $d->($o);
  } else {
    say $o;
  };
};
BEGIN {
  $tdump{ARRAY}=sub {
    for(@{$_[0]}){
      tdump($_);
    };
  };
  $tdump{HASH}=sub {
    for(values %{$_[0]}){
      tdump($_[0]->{$_});
    }
  };
  $tdump{SCALAR}=sub {
    tdump(${$_[0]});
  };
};
