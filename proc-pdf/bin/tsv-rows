sub main {
  my($col)=join(", ",@col);
  my($sql)=qq( select $col from tsv where level = 5 order by $col);
  local(*_)=TsvDB::fetchall_arrayref($sql);
  my(%set);
  for(@_){
    my($d,$p,$t,$l)=splice(@$_,0,4);
    my($h,$w,$level,$text)=@$_;
    my($b)=$h+$t;
    my($r)=$l+$w;
    my(%obj)=(
      doc=>$d,
      page=>$p,
      y1=>$t,
      y2=>$b,
      x1=>$l,
      x2=>$r,
      level=>$level,
      text=>$text
    ); 
    my($k)=join("",\%obj);
    $row{$k}=\%obj;
    push(@{$set{$d}{$p}}, $k);
  };
  our(%doc,@row,@word,@line,@page);
  for my $doc(nsort(keys %set)) {
    STDERR->say(1, $set{$doc});
    local(*doc)=$set{$doc};
    for my $page(nsort(keys %doc)) {
      STDERR->say(2, $doc{$page});
      local(*page)=$doc{$page};
      eex(0+@page);
      for(@page) {
        eex($row{$_});
      };
