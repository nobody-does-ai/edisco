#!/usr/bin/perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use lib "lib";
use common::sense;
use autodie;
use Nobody::Util;
use Nobody::PP;
use TsvUtil qw(group_find vert_sort words_merge);
use TsvFile;
use TsvDoc;
our(@VERSION) = qw( 0 1 0 );

sub main;
main(@ARGV);
exit(0);
sub main {
  my(%doc);
  @_=[glob("tsv/*.tsv")]->[0] unless @_;
  @_=sort @_;
  for my $file(@_) {
    my($p)=path($file);
    my($key)=($file=~m{(\d\d\d\d-Q\d)})[0];
    $doc{$key}//=TsvDoc->new($key);
    $doc{$key}->page(TsvFile->new($p));
  };
  for my $key(sort keys %doc){
    my($d)=TsvDoc->new($key,$doc{$key});
    say $d->key;
    for my $page(@{$d->pages}){
      my(@words)=@{$page->word};
      my(@rows);
      while(@words){
        my(@row)=group_find(\@words);
        push(@rows,\@row);
      };
    };
  };
};
