#!/opt/bin/vi-perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use common::sense;
use Tsv;
use autodie;
use Nobody::Util;
use TsvUtil;
use TsvWord;
use TsvText;
use Carp qw( croak confess carp cluck );
use Carp::Always;
use Tsv;
use TsvLine;
our(@VERSION) = qw( 0 1 0 );
sub proc_file($);
my(%data);
sub main {
  local(@_)=@_;
  @_=map { path($_) } sort glob("tsv/202?-Q?.tsv") unless @_;
  for(@_) {
    local(@_)=map { split m{([/.-])} } $_->basename(".tsv");
    my($y,undef,$q)=@_;
    eex(@_);
    $data{$y}{$q}=proc_file($_);
  };
  use Data::Dumper;
  $Data::Dumper::Terse=1;
  $Data::Dumper::Sortkeys=1;
  path("dat/all.dat.pl")->touchpath->spew(Dumper(\%data));
};
{
  sub proc_file($) {
    die "usage: proc_file(\$if)" unless @_==1;
    die "paths required" unless @_==(grep { safe_isa($_,'Path::Tiny') } @_);
    my(@all,@inv,@trn); 
    my($part)=\@all;
    my(%trig) = map { $_, $part } qw(
    TRANSACTIONS INVESTMENTS INSURED Page POLLOCK
    );
    $_=$part for(values %trig);
    $trig{TRANSACTIONS}=\@trn;
    $trig{INVESTMENTS}=\@inv;
    my($if)=shift;
    my($of)=$_;
    for($of){
      s{tsv}{html}g;
      $_=path($_);
    };
    @_=TsvWord->load_file($if);
    @_=TsvLine->from(@_);
    while(@_) {
      my($text)=$_[0]->word(0)->text;
      if($trig{$text}) {
        if($part ne $trig{$text}) {
          $part=$trig{$text};
          push(@$part,$_[0]);
        };
      }
      push(@$part,shift);
    }
    my($rel)={ inv=>\@inv, trn=>\@trn, all=>\@all };
    $rel;
  };
}
main(@ARGV);
