#!/opt/bin/vi-perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
  if 0;
$|++;
use lib "lib";
use common::sense;
use Tsv;
use autodie;
use Nobody::Util;
use TsvUtil;
use Carp qw( croak confess carp cluck );
use Carp::Always;
use Tsv;
use TsvLine;
BEGIN {
  use TsvWord;
};
our(@VERSION) = qw( 0 1 0 );
my(%trig) = map { $_, 1 } qw( TRANSACTIONS INVESTMENTS INSURED Page POLLOCK );
sub proc_file($);
sub main {
  local(@_)=@_;
  @_=map { path($_) } sort glob("tsv/2024-Q1.tsv");
  for(@_) {
    proc_file($_);
  };
};
sub proc_file($) {
  die "usage: proc_file(\$if,\$of)" unless @_==1;
  die "paths required" unless @_==(grep { safe_isa($_,'Path::Tiny') } @_);
  my($if)=shift;
  my($of)=$_;
  for($of){
    s{tsv}{html}g;
    $_=path($_);
  };
  @_=TsvWord->load_file($if);
  @_=grep { defined } @_;
  next unless @_;
  @_=grep { $_->level == 5 } @_;
  @_=sort { $a->cy <=> $b->cy } @_;
  my(@all,@inv,@trn); 
  my(%trig)=%trig;
  for(values %trig){
    $_=\@all;
  };
  $trig{TRANSACTIONS}=\@trn;
  $trig{INVESTMENTS}=\@inv;
  my($part)=\@all;
  @_=TsvLine->from(@_);
  while(@_) {
    my($text)=$_[0]->word->text;
    if($trig{$text}) {
      $part=$trig{$text};
    }
    push(@$part,shift);
  }
  for(@inv) {
    say $_->text;
  };
  my($rel)=Tsv->new({ inv=>\@inv, trn=>\@trn, all=>\@all });
  use Data::Dumper;
  local($Data::Dumper::Terse=1);
  path("dat/dat.pl")->touchpath->spew(Dumper($rel));
};
