#!/usr/bin/perl
# vim: ts=2 sw=2 ft=perl
eval 'exec perl -x -wS $0 ${1+"$@"}'
if 0;
$|++;
use common::sense;
use autodie;
use Nobody::Util;
use Getopt::WonderBra;
BEGIN { use lib "lib"; };
use TsvUtil;
use TsvUtil @TsvUtil::EXPORT_OK;
our(@VERSION) = qw( 0 1 0 );

# ppdf-big-png Split PDF into individual pages,
#   convert each page to png, append each page
#   to a single file.

sub help {
  say("Use The Source, Luke!");
}
sub main (@) {
  local(@_)=@_;
  @_=sort glob("src/*.pdf") unless @_;
  my(%of);
  for(@_){
    my($if)=$_;
    s{pdf$}{png};
    my($of)=join("/",path($_)->parent,path($if)->basename().".tmp.png");
    my(@cmd)=qw(convert -density 300 $if -append $of);
    $_=eval($_) for grep {  m{^\$[a-z]+$} } @cmd;
    eex(@cmd);
    next if -e $of;
    if(my $pid=fork){
      $of{$pid}=$of;
    } else {
      exec @cmd;
    };
    eex([$$,\%of]);
  };
  my($pid);
  while(($pid=waitpid(0,0))>1) {
    say "$pid returned $?";
    my($on)=$of{$pid};
    my($nn)=grep { s{[.]tmp[.]}{.} } $of{$pid};
    path($on)->move($nn);
    say $nn;
  };
}



main(@ARGV);
