-  say STDERR "-"x40;
-  warn "processing sql: \n\n$sql\n\n";
-  say STDERR "-"x40;
-  warn "ERROR: ", dbh->errstr, "\n";
-  say STDERR "-"x40;
-  eex "here"; 
